/* ============================================================
   全局样式 + 设计令牌（Design Tokens）
   统一全项目颜色 / 圆角 / 阴影规范，所有页面应优先使用变量
   ============================================================ */
page {
  /* ---- 品牌色 ---- */
  --color-primary: #0077C2;
  --color-primary-light: #59a5f5;
  --color-primary-bg: #E8F3FF;

  /* ---- 语义色 ---- */
  --color-success: #00B42A;
  --color-success-bg: #E8FFEA;
  --color-warning: #FF7D00;
  --color-warning-bg: #FFF7E8;
  --color-danger: #e74c3c;
  --color-danger-bg: #FDECEA;
  --color-info: #0077C2;

  /* ---- 文字色（满足 WCAG AA 对比度） ---- */
  --color-text-1: #1a1a1a;   /* 标题 / 主数值 */
  --color-text-2: #333333;   /* 正文 */
  --color-text-3: #5c5c5c;   /* 次要文字 */
  --color-text-4: #999999;   /* 辅助文字（≥3:1） */
  --color-text-disabled: #cccccc;

  /* ---- 背景色 ---- */
  --color-bg: #f5f5f5;
  --color-card: #FFFFFF;
  --color-border: #f5f5f5;

  /* ---- 圆角 ---- */
  --radius-sm: 8rpx;
  --radius-md: 12rpx;
  --radius-lg: 16rpx;
  --radius-pill: 100rpx;

  /* ---- 阴影 ---- */
  --shadow-card: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  --shadow-float: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);

  /* ---- 字体 ---- */
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, 'PingFang SC', 'Microsoft YaHei', Arial, sans-serif;
  font-size: 28rpx;
  color: var(--color-text-2);
  background-color: var(--color-bg);
  box-sizing: border-box;
}

view, text, image, navigator {
  box-sizing: border-box;
}

/* 通用容器 */
.container {
  padding: 0 30rpx;
}

/* Loading & Empty */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #cccccc;
  border-top-color: #0077C2;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: #5c5c5c;
}

.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 20rpx;
  opacity: 0.4;
}

.empty-text {
  font-size: 28rpx;
  color: #5c5c5c;
}

/* 错误状态 */
.error-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 40rpx;
}

.error-icon {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.error-title {
  font-size: 28rpx;
  color: #333333;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.error-desc {
  font-size: 24rpx;
  color: #5c5c5c;
  margin-bottom: 32rpx;
  text-align: center;
}

.error-retry-btn {
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 40rpx;
  background: #0077C2;
  color: #ffffff;
  font-size: 26rpx;
  border-radius: 8rpx;
  text-align: center;
}

.error-retry-btn:active {
  opacity: 0.8;
}
