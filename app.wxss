/* 全局样式 */
page {
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, 'PingFang SC', 'Microsoft YaHei', Arial, sans-serif;
  font-size: 28rpx;
  color: #333333;
  background-color: #f5f5f5;
  box-sizing: border-box;
}

view, text, image, navigator {
  box-sizing: border-box;
}

/* 通用容器 */
.container {
  padding: 0 30rpx;
}

/* Loading & Empty */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #cccccc;
  border-top-color: #0077C2;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: #5c5c5c;
}

.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 20rpx;
  opacity: 0.4;
}

.empty-text {
  font-size: 28rpx;
  color: #5c5c5c;
}

/* 错误状态 */
.error-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 40rpx;
}

.error-icon {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.error-title {
  font-size: 28rpx;
  color: #333333;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.error-desc {
  font-size: 24rpx;
  color: #5c5c5c;
  margin-bottom: 32rpx;
  text-align: center;
}

.error-retry-btn {
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 40rpx;
  background: #0077C2;
  color: #ffffff;
  font-size: 26rpx;
  border-radius: 8rpx;
  text-align: center;
}

.error-retry-btn:active {
  opacity: 0.8;
}
