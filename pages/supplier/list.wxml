<view class="page">

  <!-- ========== 搜索栏 ========== -->
  <view class="search-bar">
    <view class="search-box">
      <view class="search-icon"></view>
      <input class="search-input" placeholder="搜索名称/联系人/电话" value="{{keyword}}" bindinput="onSearchInput" bindconfirm="onSearch" confirm-type="search" />
      <view class="search-clear" wx:if="{{keyword}}" bindtap="onClearSearch">
        <view class="clear-icon"></view>
      </view>
    </view>
  </view>

  <!-- ========== 内容区域 ========== -->
  <view class="content-area">

    <!-- 加载骨架 -->
    <view class="skeleton-wrap" wx:if="{{loading && list.length === 0}}">
      <view class="skeleton-card" wx:for="{{[1,2,3]}}" wx:key="*this">
        <view class="skeleton-row">
          <view class="skeleton-avatar"></view>
          <view class="skeleton-lines">
            <view class="skeleton-line skeleton-name"></view>
            <view class="skeleton-line skeleton-phone"></view>
          </view>
        </view>
      </view>
    </view>

    <!-- 搜索为空 -->
    <view class="empty-wrap" wx:elif="{{searched && list.length === 0}}">
      <view class="empty-icon-wrap">
        <view class="empty-icon-search"></view>
      </view>
      <text class="empty-title">未找到匹配供应商</text>
      <text class="empty-desc">试试其他关键词</text>
    </view>

    <!-- 数据为空 -->
    <view class="empty-wrap" wx:elif="{{!loading && !searched && list.length === 0 && loaded}}">
      <view class="empty-icon-wrap">
        <view class="empty-icon-box"></view>
      </view>
      <text class="empty-title">暂无供应商</text>
      <text class="empty-desc">点击下方按钮添加首个供应商</text>
    </view>

    <!-- 列表 -->
    <view class="list-wrap" wx:else>
      <view class="list-card" wx:for="{{list}}" wx:key="id" bindtap="onEdit" data-id="{{item.id}}">
        <view class="card-left">
          <view class="card-avatar avatar-supplier">{{item.initial}}</view>
        </view>
        <view class="card-body">
          <view class="card-name-row">
            <text class="card-name">{{item.name}}</text>
            <view class="status-tag tag-{{item.statusCls}}">{{item.statusLabel}}</view>
          </view>
          <view class="card-info-row" wx:if="{{item.contactPerson}}">
            <view class="info-icon info-icon-person"></view>
            <text class="card-info-text">{{item.contactPerson}}</text>
          </view>
          <view class="card-info-row" wx:if="{{item.phone}}">
            <view class="info-icon info-icon-phone"></view>
            <text class="card-info-text">{{item.phone}}</text>
          </view>
          <view class="card-info-row card-addr-row" wx:if="{{item.address}}">
            <view class="info-icon info-icon-addr"></view>
            <text class="card-addr-text">{{item.address}}</text>
          </view>
        </view>
      </view>

      <!-- 加载更多 -->
      <view class="load-more" wx:if="{{list.length > 0 && list.length < total}}">
        <text class="load-more-text">上拉加载更多</text>
      </view>
      <view class="load-more" wx:elif="{{list.length > 0 && list.length >= total && total > 0}}">
        <text class="load-more-text">— 已显示全部 {{total}} 家供应商 —</text>
      </view>
    </view>

  </view>

  <!-- ========== 底部操作栏 ========== -->
  <view class="bottom-action">
    <view class="action-inner">
      <view class="action-count" wx:if="{{total > 0}}">
        <text class="count-num">{{total}}</text>
        <text class="count-label">家供应商</text>
      </view>
      <view class="action-btn action-btn-supplier" bindtap="onAdd">
        <view class="btn-plus"></view>
        <text>添加供应商</text>
      </view>
    </view>
  </view>

  <!-- ========== 弹窗表单 ========== -->
  <view class="modal-mask" wx:if="{{showModal}}" bindtap="onCloseModal"></view>
  <view class="modal-panel {{showModal ? 'show' : ''}}">
    <view class="modal-header">
      <text class="modal-title">{{editingId ? '编辑供应商' : '新增供应商'}}</text>
      <view class="modal-close" bindtap="onCloseModal">
        <view class="close-icon"></view>
      </view>
    </view>
    <view class="modal-body">
      <view class="form-row" wx:if="{{editingId}}">
        <text class="form-label">编码</text>
        <text class="form-readonly">{{form.code}}</text>
      </view>
      <view class="form-row" wx:else>
        <text class="form-label">编码</text>
        <text class="form-readonly form-auto-code">保存后自动生成</text>
      </view>
      <view class="form-row">
        <text class="form-label">状态</text>
        <picker mode="selector" range="{{statusNames}}" value="{{statusIndex}}" bindchange="onStatusChange">
          <view class="form-picker has-value">
            <text>{{statusNames[statusIndex]}}</text>
            <view class="picker-arrow"></view>
          </view>
        </picker>
      </view>
      <view class="form-row">
        <text class="form-label">名称</text>
        <input class="form-input" placeholder="供应商名称" value="{{form.name}}" bindinput="onFormFieldInput" data-field="name" />
      </view>
      <view class="form-row">
        <text class="form-label">联系人</text>
        <input class="form-input" placeholder="联系人姓名" value="{{form.contactPerson}}" bindinput="onFormFieldInput" data-field="contactPerson" />
      </view>
      <view class="form-row">
        <text class="form-label">电话</text>
        <input class="form-input" type="number" placeholder="联系电话" value="{{form.phone}}" bindinput="onFormFieldInput" data-field="phone" />
      </view>
      <view class="form-row">
        <text class="form-label">地址</text>
        <input class="form-input" placeholder="公司地址" value="{{form.address}}" bindinput="onFormFieldInput" data-field="address" />
      </view>
      <view class="form-row">
        <text class="form-label">备注</text>
        <input class="form-input" placeholder="备注信息" value="{{form.remark}}" bindinput="onFormFieldInput" data-field="remark" />
      </view>
    </view>
    <view class="modal-footer">
      <button class="btn-delete" wx:if="{{editingId}}" bindtap="onDelete">删除</button>
      <view class="footer-right">
        <button class="btn-cancel" bindtap="onCloseModal">取消</button>
        <button class="btn-confirm btn-confirm-supplier" bindtap="onSave">保存</button>
      </view>
    </view>
  </view>
</view>
