.page {
  padding-bottom: 48rpx;
  min-height: 100vh;
  background: #f5f5f5;
}

.search-bar {
  padding: 20rpx 36rpx;
}

.search-input-wrap {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.68);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-radius: 20rpx;
  padding: 0 24rpx;
  height: 80rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.5);
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.search-input-wrap icon-cmp {
  margin-right: 16rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
}

.supplier-list {
  padding: 0 36rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.supplier-card {
  background: rgba(255, 255, 255, 0.68);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-radius: 20rpx;
  padding: 28rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.5);
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
  transition: transform 0.2s;
}

.supplier-card:active {
  transform: scale(0.99);
}

.supplier-main {
  display: flex;
  align-items: center;
}

.supplier-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #0077C2, #59a5f5);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.supplier-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.supplier-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 6rpx;
}

.supplier-contact {
  font-size: 24rpx;
  color: #5c5c5c;
}

.fab {
  position: fixed;
  right: 40rpx;
  bottom: 60rpx;
  width: 100rpx;
  height: 100rpx;
  background: #0077C2;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(0, 119, 194, 0.35);
  z-index: 100;
}

.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 200;
}

.modal-panel {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #ffffff;
  border-radius: 28rpx 28rpx 0 0;
  z-index: 201;
  transform: translateY(100%);
  transition: transform 0.3s ease;
  padding-bottom: env(safe-area-inset-bottom);
}

.modal-panel.show {
  transform: translateY(0);
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 36rpx 20rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.04);
}

.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #333333;
}

.modal-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-body {
  padding: 20rpx 36rpx;
  max-height: 60vh;
  overflow-y: auto;
}

.form-row {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.04);
}

.form-row:last-child {
  border-bottom: none;
}

.form-label {
  font-size: 28rpx;
  color: #333333;
  width: 140rpx;
  flex-shrink: 0;
}

.form-input {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
  text-align: right;
}

.modal-footer {
  display: flex;
  gap: 18rpx;
  padding: 20rpx 36rpx;
  border-top: 1rpx solid rgba(0, 0, 0, 0.04);
}

.btn-delete {
  width: 120rpx;
  height: 80rpx;
  line-height: 80rpx;
  background: rgba(255, 77, 79, 0.08);
  color: #ff4d4f;
  font-size: 26rpx;
  border-radius: 16rpx;
  border: none;
  text-align: center;
}

.btn-cancel {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  background: rgba(0, 0, 0, 0.04);
  color: #5c5c5c;
  font-size: 26rpx;
  border-radius: 16rpx;
  border: none;
  text-align: center;
}

.btn-confirm {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  background: #0077C2;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 16rpx;
  border: none;
  text-align: center;
}

.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-text {
  font-size: 26rpx;
  color: #5c5c5c;
}
