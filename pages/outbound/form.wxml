<view class="page">

  <!-- ===== 页面头部 ===== -->
  <view class="page-header">
    <text class="page-header-title">{{id ? '销售出库单详情' : '新增销售出库单'}}</text>
    <text class="page-header-sub">{{id ? (editing ? '编辑出库信息' : '查看出库信息') : '填写以下信息创建出库单'}}</text>
  </view>

  <!-- 状态提示 -->
  <view class="status-banner status-banner-{{statusCls}}" wx:if="{{id}}">
    <text class="status-banner-text">● {{statusText}}</text>
  </view>

  <!-- ===== 出库单信息 ===== -->
  <view class="section-card">
    <view class="section-header">
      <view class="section-header-left">
        <view class="section-icon section-icon-outbound"></view>
        <text class="section-title">出库单信息</text>
      </view>
      <view class="change-btn" wx:if="{{selectedCustomer && editing && !fromSalesOrder}}" bindtap="onClearCustomer">
        <text class="change-btn-text">更换客户</text>
      </view>
    </view>

    <view class="order-form-item order-form-item-column">
      <text class="order-form-label">客户</text>
      <view wx:if="{{!customerName && editing && !fromSalesOrder}}" class="customer-search-wrap">
        <view class="search-field {{showCustomerResults && filteredCustomers.length > 0 ? 'search-field-active' : ''}}">
          <view class="search-field-icon">
            <icon-cmp type="search" size="18" color="#999"></icon-cmp>
          </view>
          <input
            class="search-field-input"
            placeholder="搜索客户名称"
            placeholder-class="placeholder"
            value="{{customerKeyword}}"
            bindinput="onCustomerInput"
            bindfocus="onCustomerFocus"
            bindblur="onCustomerBlur"
          />
        </view>
        <view class="search-results" wx:if="{{showCustomerResults && filteredCustomers.length > 0}}">
          <view class="search-result-item" wx:for="{{filteredCustomers}}" wx:key="id" data-index="{{index}}" bindtap="onCustomerSelect">
            <view class="result-item-info">
              <text class="result-item-name">{{item.name}}</text>
              <text class="result-item-contact" wx:if="{{item.contactPerson}}">{{item.contactPerson}}</text>
            </view>
          </view>
        </view>
        <view class="search-empty" wx:elif="{{showCustomerResults && filteredCustomers.length === 0}}">
          <text class="search-empty-text">未找到匹配的客户</text>
        </view>
      </view>
      <view class="customer-selected-inline" wx:else>
        <view class="customer-avatar-sm">{{customerInitial}}</view>
        <text class="customer-name-inline">{{customerName}}</text>
        <text class="customer-contact-inline" wx:if="{{selectedCustomer && selectedCustomer.contactPerson}}">· {{selectedCustomer.contactPerson}}</text>
      </view>
    </view>

    <view class="order-form-item">
      <text class="order-form-label">出库单号</text>
      <text wx:if="{{orderNo}}" class="order-form-value">{{orderNo}}</text>
      <text wx:else class="order-form-value placeholder">保存后自动生成</text>
    </view>

    <view class="order-form-item">
      <text class="order-form-label">来源销售单</text>
      <text class="order-form-value" wx:if="{{salesOrderNo}}">{{salesOrderNo}}</text>
      <text class="order-form-value placeholder" wx:else>—</text>
    </view>

    <view class="order-form-item">
      <text class="order-form-label">仓库</text>
      <picker mode="selector" range="{{warehouseNames}}" value="{{warehouseIndex}}" bindchange="onWarehouseChange" disabled="{{!editing || fromSalesOrder}}">
        <view class="order-form-picker {{warehouseName ? 'has-value' : ''}}">
          <text wx:if="{{warehouseName}}">{{warehouseName}}</text>
          <text wx:else class="placeholder">选择仓库</text>
          <view class="picker-arrow" wx:if="{{editing && !fromSalesOrder}}"></view>
        </view>
      </picker>
    </view>

    <view class="order-form-item">
      <text class="order-form-label">出库日期</text>
      <picker mode="date" value="{{outboundDate}}" bindchange="onDateChange" disabled="{{!editing}}">
        <view class="order-form-picker {{outboundDate ? 'has-value' : ''}}">
          <text wx:if="{{outboundDate}}">{{outboundDate}}</text>
          <text wx:else class="placeholder">选择日期</text>
          <view class="picker-arrow" wx:if="{{editing}}"></view>
        </view>
      </picker>
    </view>

    <view class="order-form-item">
      <text class="order-form-label">备注</text>
      <input class="order-form-input" placeholder="选填" placeholder-class="placeholder" value="{{remark}}" maxlength="200" bindinput="onRemarkInput" disabled="{{!editing}}" />
    </view>
  </view>

  <!-- ===== 商品明细 ===== -->
  <view class="section-card">
    <view class="section-header">
      <view class="section-header-left">
        <view class="section-icon section-icon-items"></view>
        <text class="section-title">出库商品</text>
      </view>
      <view class="items-count">
        <text class="items-count-num">{{items.length}}</text>
        <text class="items-count-label">项</text>
      </view>
    </view>

    <!-- 商品搜索（编辑模式下） -->
    <view class="product-search-area" wx:if="{{editing && !fromSalesOrder}}">
      <view class="ps-field {{showProductResults ? 'ps-field-active' : ''}}">
        <icon-cmp type="search" size="18" color="#999"></icon-cmp>
        <input
          class="ps-input"
          placeholder="搜索商品名称，点击添加"
          placeholder-class="placeholder"
          value="{{productKeyword}}"
          bindinput="onProductSearchInput"
          bindfocus="onProductSearchFocus"
          bindblur="onProductSearchBlur"
        />
      </view>
      <view class="ps-list" wx:if="{{showProductResults && productSearchResults.length > 0}}">
        <view class="ps-item" wx:for="{{productSearchResults}}" wx:key="id" data-pid="{{item.id}}" bindtap="onProductSearchSelect">
          <view class="ps-item-info">
            <text class="ps-item-name">{{item.name}}</text>
            <text class="ps-item-spec">{{item.spec || '-'}} · {{item.unit ? item.unit.name : '-'}}<text wx:if="{{item.manufacturer}}"> · {{item.manufacturer}}</text></text>
          </view>
          <view class="ps-item-add">+</view>
        </view>
      </view>
      <text class="ps-empty-text" wx:elif="{{showProductResults && productSearchResults.length === 0}}">未找到匹配的商品</text>
    </view>

    <view class="items-list" wx:if="{{items.length > 0}}">
      <view class="item-card" wx:for="{{items}}" wx:key="index">

        <view class="item-card-body">
          <!-- 行号徽章 -->
          <view class="row-badge">
            <text class="row-badge-text">{{index + 1}}</text>
          </view>

          <!-- 商品信息 -->
          <view class="item-content">
            <view class="item-content-top">
              <view class="item-product-info">
                <text class="item-name">{{item.productName}}</text>
                <view class="item-meta">
                  <text class="item-meta-text" wx:if="{{item.productSpec}}">{{item.productSpec}}</text>
                  <text class="item-meta-divider" wx:if="{{item.productSpec && item.productUnit}}">·</text>
                  <text class="item-meta-text" wx:if="{{item.productUnit}}">{{item.productUnit}}</text>
                </view>
                <text class="item-manufacturer">{{item.productManufacturer || '-'}}</text>
              </view>
              <view class="item-amount-top" wx:if="{{!editing}}">
                <text class="item-amount-top-value">¥{{item.amount || '0.00'}}</text>
              </view>
              <view class="item-remove-btn" wx:if="{{editing}}" bindtap="onRemoveItem" data-index="{{index}}">
                <text class="item-remove-icon">✕</text>
              </view>
            </view>

            <!-- 编辑模式：数量/单价/小计 -->
            <view class="item-prices" wx:if="{{editing}}">
              <view class="item-prices-row">
                <view class="item-price-field">
                  <text class="item-price-label">数量</text>
                  <view class="qty-control">
                    <view class="qty-btn" bindtap="onQtyDecrease" data-index="{{index}}">−</view>
                    <input class="qty-input" type="digit" placeholder="0" placeholder-class="placeholder-center" value="{{item.quantity}}" data-index="{{index}}" bindinput="onItemQuantityInput" />
                    <view class="qty-btn" bindtap="onQtyIncrease" data-index="{{index}}">+</view>
                  </view>
                </view>
                <view class="item-price-field">
                  <text class="item-price-label">单价</text>
                  <view class="price-wrap">
                    <text class="price-symbol">¥</text>
                    <input class="price-input" type="digit" placeholder="0.00" placeholder-class="placeholder-center" value="{{item.price}}" data-index="{{index}}" bindinput="onItemPriceInput" />
                  </view>
                </view>
              </view>
              <view class="item-subtotal">
                <text class="subtotal-label">小计</text>
                <text class="subtotal-value">¥{{item.amount || '0.00'}}</text>
              </view>
            </view>
            <!-- 只读模式：数量/单价 -->
            <view class="item-prices-readonly" wx:else>
              <view class="price-inline-row">
                <text class="price-inline-label">数量</text>
                <text class="price-inline-value">{{item.quantity}}</text>
                <text class="price-inline-sep">·</text>
                <text class="price-inline-label">单价</text>
                <text class="price-inline-value">¥{{item.price}}</text>
              </view>
            </view>

            <!-- 编辑：批号/生产日期/有效期/货位号 -->
            <view class="item-extra-fields" wx:if="{{editing}}">
              <view class="item-extra-row">
                <view class="item-extra-field item-extra-field-half">
                  <text class="item-extra-label">批号</text>
                  <input class="item-extra-input" type="text" placeholder="必填" placeholder-class="placeholder" value="{{item.batchNo}}" data-index="{{index}}" bindinput="onBatchNoInput" disabled="{{fromSalesOrder}}" />
                </view>
                <view class="item-extra-field item-extra-field-half">
                  <text class="item-extra-label">货位号</text>
                  <input class="item-extra-input" type="text" placeholder="选填" placeholder-class="placeholder" value="{{item.locationCode}}" data-index="{{index}}" bindinput="onLocationCodeInput" />
                </view>
              </view>
              <view class="item-extra-row">
                <view class="item-extra-field item-extra-field-half">
                  <text class="item-extra-label">生产日期</text>
                  <picker mode="date" value="{{item.productionDate}}" data-index="{{index}}" bindchange="onProductionDateChange" disabled="{{fromSalesOrder}}">
                    <view class="item-extra-picker {{item.productionDate ? 'has-value' : ''}}">
                      <text wx:if="{{item.productionDate}}">{{item.productionDate}}</text>
                      <text wx:else class="placeholder">必填</text>
                    </view>
                  </picker>
                </view>
                <view class="item-extra-field item-extra-field-half">
                  <text class="item-extra-label">有效期</text>
                  <picker mode="date" value="{{item.expiryDate}}" data-index="{{index}}" bindchange="onExpiryDateChange" disabled="{{fromSalesOrder}}">
                    <view class="item-extra-picker {{item.expiryDate ? 'has-value' : ''}}">
                      <text wx:if="{{item.expiryDate}}">{{item.expiryDate}}</text>
                      <text wx:else class="placeholder">必填</text>
                    </view>
                  </picker>
                </view>
              </view>
              <view class="item-extra-notice" wx:if="{{fromSalesOrder}}">
                <text class="notice-text">由销售单生成，批号/效期为系统自动分配</text>
              </view>
            </view>
            <!-- 只读：批号/生产日期/有效期/货位号 -->
            <view class="item-extra-readonly" wx:else>
              <view class="item-extra-ro-row">
                <view class="item-extra-ro-field">
                  <text class="item-extra-ro-label">批号</text>
                  <text class="item-extra-ro-value">{{item.batchNo || '-'}}</text>
                </view>
                <view class="item-extra-ro-field">
                  <text class="item-extra-ro-label">生产日期</text>
                  <text class="item-extra-ro-value">{{item.productionDate || '-'}}</text>
                </view>
              </view>
              <view class="item-extra-ro-row">
                <view class="item-extra-ro-field">
                  <text class="item-extra-ro-label">有效期</text>
                  <text class="item-extra-ro-value">{{item.expiryDate || '-'}}</text>
                </view>
                <view class="item-extra-ro-field">
                  <text class="item-extra-ro-label">货位号</text>
                  <text class="item-extra-ro-value">{{item.locationCode || '-'}}</text>
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view class="items-empty" wx:if="{{items.length === 0}}">
      <text class="items-empty-text">暂无商品，请在上方搜索添加</text>
    </view>
  </view>

  <!-- ===== 批次选择弹层 ===== -->
  <view class="batch-mask" wx:if="{{showBatchPicker}}" bindtap="onCloseBatchPicker"></view>
  <view class="batch-panel {{showBatchPicker ? 'visible' : ''}}">
    <view class="batch-panel-head">
      <text class="batch-panel-title">选择库存批次</text>
      <view class="batch-panel-close" bindtap="onCloseBatchPicker">✕</view>
    </view>
    <view class="batch-panel-product">
      <view class="batch-panel-product-left">
        <text class="batch-panel-pname">{{batchProduct && batchProduct.name}}</text>
        <text class="batch-panel-pspec">{{batchProduct && batchProduct.spec}}</text>
        <view class="batch-panel-pmanu-row">
          <text class="batch-panel-pmanu-label">生产厂家</text>
          <text class="batch-panel-pmanu-value">{{batchProduct && (batchProduct.manufacturer || '-')}}</text>
        </view>
      </view>
      <text class="batch-panel-count">{{batchOptions.length}} 批</text>
    </view>
    <view class="batch-panel-body">
      <view class="batch-card" wx:for="{{batchOptions}}" wx:key="batchCode" data-index="{{index}}" bindtap="onBatchOptionTap">
        <view class="batch-card-top">
          <view class="batch-card-batch">
            <text class="batch-card-label">批号</text>
            <text class="batch-card-batchno">{{item.batchNo || '-'}}</text>
          </view>
          <view class="batch-card-qty">
            <text class="batch-card-qty-num">{{item.quantity}}</text>
            <text class="batch-card-qty-unit">{{item._unit}}</text>
          </view>
        </view>
        <view class="batch-card-divider"></view>
        <view class="batch-card-info">
          <view class="batch-card-info-item">
            <text class="batch-card-label">生产日期</text>
            <text class="batch-card-value">{{item.productionDate || '-'}}</text>
          </view>
          <view class="batch-card-info-sep"></view>
          <view class="batch-card-info-item">
            <text class="batch-card-label">有效期至</text>
            <text class="batch-card-value">{{item.expiryDate || '-'}}</text>
          </view>
        </view>
        <view class="batch-card-info">
          <view class="batch-card-info-item">
            <text class="batch-card-label">库位</text>
            <text class="batch-card-value">{{item.locationCode || '未设库位'}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- ===== 底部操作栏（编辑模式） ===== -->
  <view class="bottom-bar" wx:if="{{editing}}">
    <view class="bottom-inner">
      <view class="bottom-summary">
        <view class="bottom-summary-left">
          <text class="summary-label">合计</text>
          <text class="summary-qty">{{totalQuantity || 0}} 件</text>
        </view>
        <text class="summary-amount">¥ {{totalAmount || '0.00'}}</text>
      </view>
      <view class="bottom-actions">
        <button class="action-btn action-draft" bindtap="onSave" disabled="{{submitting}}">{{submitting ? '保存中...' : '保存草稿'}}</button>
        <button class="action-btn action-submit" bindtap="onSubmit" disabled="{{submitting}}">{{submitting ? '提交中...' : '提交审核'}}</button>
      </view>
    </view>
  </view>

  <!-- ===== 底部操作栏（只读模式） ===== -->
  <view class="bottom-bar" wx:else>
    <view class="bottom-inner bottom-actions" wx:if="{{!id}}">
      <button class="action-btn action-back-full" bindtap="onBack">返回列表</button>
    </view>
    <view class="bottom-inner bottom-actions" wx:elif="{{statusCls === 'pending'}}">
      <button class="action-btn action-back" bindtap="onBack">返回</button>
      <button class="action-btn action-edit-toggle" bindtap="onToggleEdit">编辑</button>
      <button class="action-btn action-cancel" bindtap="onCancel" disabled="{{submitting}}">{{submitting ? '处理中...' : '取消出库'}}</button>
      <button class="action-btn action-approve" bindtap="onApprove" disabled="{{submitting}}">{{submitting ? '处理中...' : '审核通过'}}</button>
    </view>
    <view class="bottom-inner bottom-inner-single" wx:else>
      <button class="action-btn action-back-full" bindtap="onBack">返回列表</button>
    </view>
  </view>

</view>
