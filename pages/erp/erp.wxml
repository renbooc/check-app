<view class="page">

  <!-- ===== Network Error ===== -->
  <view class="error-container" wx:if="{{networkError}}">
    <image class="error-icon" src="/images/icon-document.png" mode="aspectFit"></image>
    <text class="error-title">网络开小差了</text>
    <text class="error-desc">请检查网络连接后重试</text>
    <view class="error-retry-btn" bindtap="onRetry">重新加载</view>
  </view>

  <block wx:else>
  <view class="tab-bar">
    <view class="tab-item {{activeTab === 'inbound' ? 'active' : ''}}" bindtap="onTabChange" data-tab="inbound">
      <text>采购入库</text>
    </view>
    <view class="tab-item {{activeTab === 'purchaseReturn' ? 'active' : ''}}" bindtap="onTabChange" data-tab="purchaseReturn">
      <text>采购退货</text>
    </view>
    <view class="tab-item {{activeTab === 'outbound' ? 'active' : ''}}" bindtap="onTabChange" data-tab="outbound">
      <text>销售出库</text>
    </view>
    <view class="tab-item {{activeTab === 'salesReturn' ? 'active' : ''}}" bindtap="onTabChange" data-tab="salesReturn">
      <text>销售退货</text>
    </view>
    <view class="tab-item {{activeTab === 'inventory' ? 'active' : ''}}" bindtap="onTabChange" data-tab="inventory">
      <text>库存查询</text>
    </view>
  </view>

  <view class="tab-content" wx:if="{{activeTab === 'inbound'}}">
    <view class="action-bar">
      <view class="search-wrap">
        <icon-cmp type="search" size="16" color="#999999"></icon-cmp>
        <input class="search-input" placeholder="搜索采购入库单号" value="{{inboundKeyword}}" bindinput="onInboundSearchInput" bindconfirm="onInboundSearch" />
      </view>
      <view class="btn-add" bindtap="onViewInboundList">
        <icon-cmp type="list" size="18" color="#ffffff"></icon-cmp>
        <text>全部采购入库</text>
      </view>
    </view>

    <view class="empty-container" wx:if="{{inboundList.length === 0}}">
      <icon-cmp type="file-text" size="48" color="#cccccc"></icon-cmp>
      <text class="empty-text">暂无入库单</text>
    </view>

    <view class="order-list" wx:else>
      <view class="order-card" wx:for="{{inboundList}}" wx:key="id" bindtap="onInboundTap" data-id="{{item.id}}">
        <view class="order-header">
          <text class="order-no">{{item.orderNo}}</text>
          <text class="order-status status-{{item.status}}">{{item.status === 'draft' ? '草稿' : item.status === 'pending' ? '待审核' : item.status === 'approved' ? '已审核' : item.status === 'cancelled' ? '已取消' : item.status}}</text>
        </view>
        <view class="order-body">
          <text class="order-party">{{item.supplierName || '-'}}</text>
          <text class="order-amount">¥{{item.totalAmount || '0.00'}}</text>
        </view>
        <view class="order-footer">
          <text class="order-date">{{item.createdAt}}</text>
          <text class="order-qty">{{item.totalQuantity || 0}} 件</text>
        </view>
      </view>
    </view>
  </view>

  <view class="tab-content" wx:if="{{activeTab === 'outbound'}}">
    <view class="action-bar">
      <view class="search-wrap">
        <icon-cmp type="search" size="16" color="#999999"></icon-cmp>
        <input class="search-input" placeholder="搜索出库单号" value="{{outboundKeyword}}" bindinput="onOutboundSearchInput" bindconfirm="onOutboundSearch" />
      </view>
      <view class="btn-add" bindtap="onViewOutboundList">
        <icon-cmp type="list" size="18" color="#ffffff"></icon-cmp>
        <text>全部销售出库</text>
      </view>
    </view>

    <view class="empty-container" wx:if="{{outboundList.length === 0}}">
      <icon-cmp type="file-text" size="48" color="#cccccc"></icon-cmp>
      <text class="empty-text">暂无出库单</text>
    </view>

    <view class="order-list" wx:else>
      <view class="order-card" wx:for="{{outboundList}}" wx:key="id" bindtap="onOutboundTap" data-id="{{item.id}}">
        <view class="order-header">
          <text class="order-no">{{item.orderNo}}</text>
          <text class="order-status status-{{item.status}}">{{item.status === 'pending' ? '待审核' : item.status === 'approved' ? '已审核' : item.status}}</text>
        </view>
        <view class="order-body">
          <text class="order-party">{{item.customerName || '-'}}</text>
          <text class="order-amount">¥{{item.totalAmount || '0.00'}}</text>
        </view>
        <view class="order-footer">
          <text class="order-date">{{item.createdAt}}</text>
          <text class="order-qty">{{item.totalQuantity || 0}} 件</text>
        </view>
      </view>
    </view>
  </view>

  <view class="tab-content" wx:if="{{activeTab === 'purchaseReturn'}}">
    <view class="empty-container">
      <icon-cmp type="file-text" size="48" color="#cccccc"></icon-cmp>
      <text class="empty-text">暂无采购退货记录</text>
    </view>
  </view>

  <view class="tab-content" wx:if="{{activeTab === 'salesReturn'}}">
    <view class="empty-container">
      <icon-cmp type="file-text" size="48" color="#cccccc"></icon-cmp>
      <text class="empty-text">暂无销售退货记录</text>
    </view>
  </view>

  <view class="tab-content" wx:if="{{activeTab === 'inventory'}}">
    <view class="action-bar">
      <view class="search-wrap">
        <icon-cmp type="search" size="16" color="#999999"></icon-cmp>
        <input class="search-input" placeholder="搜索商品名称/编码" value="{{inventoryKeyword}}" bindinput="onInventorySearchInput" bindconfirm="onInventorySearch" />
      </view>
      <view class="btn-add" bindtap="onAddProduct">
        <icon-cmp type="plus" size="18" color="#ffffff"></icon-cmp>
        <text>新增商品</text>
      </view>
    </view>

    <view class="empty-container" wx:if="{{inventoryList.length === 0}}">
      <icon-cmp type="package" size="48" color="#cccccc"></icon-cmp>
      <text class="empty-text">暂无库存记录</text>
    </view>

    <view class="inventory-list" wx:else>
      <view class="inventory-card" wx:for="{{inventoryList}}" wx:key="id" bindtap="onInventoryTap" data-id="{{item.productId}}">
        <view class="inv-main">
          <view class="inv-info">
            <view class="inv-name-row">
              <text class="inv-name">{{item.product ? item.product.name : '-'}}</text>
              <text class="inv-code" wx:if="{{item.product && item.product.code}}">{{item.product.code}}</text>
            </view>
            <view class="inv-spec-row">
              <text class="inv-spec" wx:if="{{item.product && item.product.spec}}">{{item.product.spec}}</text>
              <text class="inv-spec-sep" wx:if="{{item.product && item.product.spec && item.product.unit}}">·</text>
              <text class="inv-spec" wx:if="{{item.product && item.product.unit}}">{{item.product.unit.name || item.product.unit}}</text>
            </view>
            <text class="inv-manufacturer" wx:if="{{item.product && item.product.manufacturer}}">{{item.product.manufacturer}}</text>
          </view>
          <view class="inv-stock {{item.quantity <= (item.minQuantity || 0) ? 'low' : ''}}">
            <text class="inv-qty">{{item.quantity || 0}}</text>
          </view>
        </view>
        <view class="inv-meta">
          <text class="inv-warehouse">{{item.warehouse ? item.warehouse.name : '-'}}</text>
          <text class="inv-value" wx:if="{{item.amount && parseFloat(item.amount) > 0}}">¥{{item.amount}}</text>
        </view>
      </view>
    </view>
  </view>
    </block>
</view>
