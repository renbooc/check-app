<view class="page">
  <view class="tab-bar">
    <view class="tab-item {{activeTab === 'purchase' ? 'active' : ''}}" bindtap="onTabChange" data-tab="purchase">
      <text>采购订单</text>
    </view>
    <view class="tab-item {{activeTab === 'sales' ? 'active' : ''}}" bindtap="onTabChange" data-tab="sales">
      <text>销售订单</text>
    </view>
    <view class="tab-item {{activeTab === 'inventory' ? 'active' : ''}}" bindtap="onTabChange" data-tab="inventory">
      <text>库存管理</text>
    </view>
  </view>

  <view class="tab-content" wx:if="{{activeTab === 'purchase'}}">
    <view class="action-bar">
      <view class="search-wrap">
        <icon-cmp type="search" size="16" color="#999999"></icon-cmp>
        <input class="search-input" placeholder="搜索采购单号" value="{{purchaseKeyword}}" bindinput="onPurchaseSearchInput" bindconfirm="onPurchaseSearch" />
      </view>
      <view class="btn-add" bindtap="onAddPurchase">
        <icon-cmp type="plus" size="18" color="#ffffff"></icon-cmp>
        <text>新增采购</text>
      </view>
    </view>

    <view class="empty-container" wx:if="{{purchaseList.length === 0}}">
      <icon-cmp type="file-text" size="48" color="#cccccc"></icon-cmp>
      <text class="empty-text">暂无采购订单</text>
    </view>

    <view class="order-list" wx:else>
      <view class="order-card" wx:for="{{purchaseList}}" wx:key="id" bindtap="onPurchaseTap" data-id="{{item.id}}">
        <view class="order-header">
          <text class="order-no">{{item.orderNo}}</text>
          <text class="order-status status-{{item.status}}">{{item.status === 'pending' ? '待审核' : item.status === 'approved' ? '已审核' : item.status === 'received' ? '已入库' : item.status}}</text>
        </view>
        <view class="order-body">
          <text class="order-party">{{item.supplier ? item.supplier.name : '-'}}</text>
          <text class="order-amount">¥{{item.totalAmount || '0.00'}}</text>
        </view>
        <view class="order-footer">
          <text class="order-date">{{item.createdAt}}</text>
          <view class="order-actions">
            <text class="order-qty">{{item.items ? item.items.length : 0}} 种商品</text>
            <view class="btn-action btn-receive" wx:if="{{item.status === 'pending'}}" catchtap="onConfirmReceipt" data-id="{{item.id}}">确认入库</view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="tab-content" wx:if="{{activeTab === 'sales'}}">
    <view class="action-bar">
      <view class="search-wrap">
        <icon-cmp type="search" size="16" color="#999999"></icon-cmp>
        <input class="search-input" placeholder="搜索销售单号" value="{{salesKeyword}}" bindinput="onSalesSearchInput" bindconfirm="onSalesSearch" />
      </view>
      <view class="btn-add" bindtap="onAddSales">
        <icon-cmp type="plus" size="18" color="#ffffff"></icon-cmp>
        <text>新增销售</text>
      </view>
    </view>

    <view class="empty-container" wx:if="{{salesList.length === 0}}">
      <icon-cmp type="file-text" size="48" color="#cccccc"></icon-cmp>
      <text class="empty-text">暂无销售订单</text>
    </view>

    <view class="order-list" wx:else>
      <view class="order-card" wx:for="{{salesList}}" wx:key="id" bindtap="onSalesTap" data-id="{{item.id}}">
        <view class="order-header">
          <text class="order-no">{{item.orderNo}}</text>
          <text class="order-status status-{{item.status}}">{{item.status === 'pending' ? '待审核' : item.status === 'approved' ? '已审核' : item.status === 'delivered' ? '已出库' : item.status}}</text>
        </view>
        <view class="order-body">
          <text class="order-party">{{item.customer ? item.customer.name : '-'}}</text>
          <text class="order-amount">¥{{item.totalAmount || '0.00'}}</text>
        </view>
        <view class="order-footer">
          <text class="order-date">{{item.createdAt}}</text>
          <view class="order-actions">
            <text class="order-qty">{{item.items ? item.items.length : 0}} 种商品</text>
            <view class="btn-action btn-deliver" wx:if="{{item.status === 'pending'}}" catchtap="onConfirmDelivery" data-id="{{item.id}}">确认出库</view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="tab-content" wx:if="{{activeTab === 'inventory'}}">
    <view class="action-bar">
      <view class="search-wrap">
        <icon-cmp type="search" size="16" color="#999999"></icon-cmp>
        <input class="search-input" placeholder="搜索商品名称/编码" value="{{inventoryKeyword}}" bindinput="onInventorySearchInput" bindconfirm="onInventorySearch" />
      </view>
      <view class="btn-add" bindtap="onAddProduct">
        <icon-cmp type="plus" size="18" color="#ffffff"></icon-cmp>
        <text>新增商品</text>
      </view>
    </view>

    <view class="empty-container" wx:if="{{inventoryList.length === 0}}">
      <icon-cmp type="package" size="48" color="#cccccc"></icon-cmp>
      <text class="empty-text">暂无库存记录</text>
    </view>

    <view class="inventory-list" wx:else>
      <view class="inventory-card" wx:for="{{inventoryList}}" wx:key="id" bindtap="onInventoryTap" data-id="{{item.productId}}">
        <view class="inv-main">
          <view class="inv-info">
            <text class="inv-name">{{item.product ? item.product.name : '-'}}</text>
            <text class="inv-code">{{item.product ? item.product.code : '-'}}</text>
          </view>
          <view class="inv-stock {{item.quantity <= (item.minQuantity || 0) ? 'low' : ''}}">
            <text class="inv-qty">{{item.quantity || 0}}</text>
            <text class="inv-unit">{{item.product ? item.product.unit : ''}}</text>
          </view>
        </view>
        <view class="inv-meta">
          <text class="inv-warehouse">{{item.warehouse ? item.warehouse.name : '-'}}</text>
          <text class="inv-value">¥{{item.amount || '0.00'}}</text>
        </view>
      </view>
    </view>
  </view>
</view>
