<view class="page">

  <!-- ===== 页面头部 ===== -->
  <view class="page-header">
    <text class="page-header-title">{{editingId ? '编辑商品' : '新增商品'}}</text>
    <text class="page-header-sub">填写商品基本信息和价格库存</text>
  </view>

  <!-- ===== 基本信息卡片 ===== -->
  <view class="section-card">
    <view class="section-header">
      <view class="section-header-left">
        <view class="section-icon section-icon-info"></view>
        <text class="section-title">基本信息</text>
      </view>
    </view>

    <!-- 商品名称（主角） -->
    <view class="form-item form-item-highlight">
      <text class="form-label">商品名称 <text class="required">*</text></text>
      <input
        class="form-input"
        placeholder="输入商品名称"
        placeholder-class="placeholder"
        value="{{form.name}}"
        bindinput="onFieldInput"
        data-field="name"
      />
    </view>

    <!-- 新增时编码自动生成，编辑时显示只读 -->
    <view class="form-item" wx:if="{{editingId}}">
      <text class="form-label">商品编码</text>
      <view class="form-readonly">{{form.code}}</view>
    </view>
    <view class="form-item" wx:else>
      <text class="form-label">商品编码</text>
      <view class="form-readonly form-auto-code">保存后自动生成</view>
    </view>

    <view class="form-item">
      <text class="form-label">商品状态</text>
      <picker
        mode="selector"
        range="{{statusNames}}"
        value="{{statusIndex}}"
        bindchange="onStatusChange"
      >
        <view class="form-picker {{statusIndex >= 0 ? 'has-value' : ''}}">
          <text>{{statusNames[statusIndex]}}</text>
          <view class="picker-arrow"></view>
        </view>
      </picker>
    </view>

    <view class="form-item">
      <text class="form-label">规格型号</text>
      <input
        class="form-input"
        placeholder="如：0.25g×24粒"
        placeholder-class="placeholder"
        value="{{form.spec}}"
        bindinput="onFieldInput"
        data-field="spec"
      />
    </view>

    <view class="form-item">
      <text class="form-label">单位</text>
      <picker
        mode="selector"
        range="{{unitNames}}"
        value="{{unitIndex}}"
        bindchange="onUnitChange"
      >
        <view class="form-picker {{unitIndex >= 0 ? 'has-value' : ''}}">
          <text wx:if="{{unitIndex >= 0}}">{{unitNames[unitIndex]}}</text>
          <text wx:else class="placeholder">选择单位</text>
          <view class="picker-arrow"></view>
        </view>
      </picker>
    </view>

    <view class="form-item">
      <text class="form-label">分类</text>
      <picker
        mode="selector"
        range="{{categoryNames}}"
        value="{{categoryIndex}}"
        bindchange="onCategoryChange"
      >
        <view class="form-picker {{categoryIndex >= 0 ? 'has-value' : ''}}">
          <text wx:if="{{categoryIndex >= 0}}">{{categoryNames[categoryIndex]}}</text>
          <text wx:else class="placeholder">选择分类</text>
          <view class="picker-arrow"></view>
        </view>
      </picker>
    </view>
  </view>

  <!-- ===== 价格与库存卡片 ===== -->
  <view class="section-card">
    <view class="section-header">
      <view class="section-header-left">
        <view class="section-icon section-icon-price"></view>
        <text class="section-title">价格与库存</text>
      </view>
    </view>

    <view class="form-item">
      <text class="form-label">参考售价</text>
      <view class="input-with-prefix">
        <text class="input-prefix">¥</text>
        <input
          class="form-input"
          type="digit"
          placeholder="0.00"
          placeholder-class="placeholder"
          value="{{form.price}}"
          bindinput="onFieldInput"
          data-field="price"
        />
      </view>
    </view>

    <view class="form-item">
      <text class="form-label">最低库存</text>
      <input
        class="form-input"
        type="number"
        placeholder="低于此值将预警"
        placeholder-class="placeholder"
        value="{{form.minQuantity}}"
        bindinput="onFieldInput"
        data-field="minQuantity"
      />
    </view>

    <view class="form-item">
      <text class="form-label">批准文号</text>
      <input
        class="form-input"
        placeholder="如：国药准字H20000001"
        placeholder-class="placeholder"
        value="{{form.approvalNo}}"
        bindinput="onFieldInput"
        data-field="approvalNo"
      />
    </view>

    <view class="form-item">
      <text class="form-label">生产企业</text>
      <input
        class="form-input"
        placeholder="生产企业名称"
        placeholder-class="placeholder"
        value="{{form.manufacturer}}"
        bindinput="onFieldInput"
        data-field="manufacturer"
      />
    </view>
  </view>

  <!-- ===== 其他信息卡片 ===== -->
  <view class="section-card">
    <view class="section-header">
      <view class="section-header-left">
        <view class="section-icon section-icon-other"></view>
        <text class="section-title">其他信息</text>
      </view>
    </view>

    <view class="form-item">
      <text class="form-label">备注</text>
      <input
        class="form-input"
        placeholder="选填"
        placeholder-class="placeholder"
        value="{{form.remark}}"
        maxlength="500"
        bindinput="onFieldInput"
        data-field="remark"
      />
    </view>
  </view>

  <!-- ===== 底部操作栏 ===== -->
  <view class="bottom-bar">
    <button class="btn-save" bindtap="onSubmit" disabled="{{submitting}}">
      {{submitting ? '保存中...' : '保存商品'}}
    </button>
  </view>

</view>
