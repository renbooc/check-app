<view class="page">

  <!-- Loading -->
  <view class="loading-wrap" wx:if="{{pageLoading}}">
    <view class="loading-dot"></view>
  </view>

  <block wx:elif="{{product}}">

    <!-- ===== 页面头部（琥珀渐变，与商品信息页一致） ===== -->
    <view class="page-header">
      <view class="header-top">
        <view class="header-info">
          <text class="product-name">{{product.name}}</text>
          <view class="product-meta">
            <text class="product-code" wx:if="{{product.code}}">{{product.code}}</text>
            <text class="meta-sep" wx:if="{{product.code && product.categoryName}}">/</text>
            <text class="product-category" wx:if="{{product.categoryName}}">{{product.categoryName}}</text>
          </view>
        </view>
        <view class="status-tag {{statusClass}}">
          <text class="status-tag-text">{{statusLabel}}</text>
        </view>
      </view>
    </view>

    <!-- ===== 库存指标卡片（主角：当前库存数量） ===== -->
    <view class="section-card">
      <view class="section-header">
        <view class="section-header-left">
          <view class="section-icon section-icon-stock"></view>
          <text class="section-title">库存概况</text>
        </view>
      </view>

      <view class="stock-metric">
        <text class="stock-num {{isLowStock ? 'num-danger' : ''}}">{{inventory.quantity || 0}}</text>
        <text class="stock-unit">{{product.unitName || '件'}}</text>
        <text class="stock-desc">当前库存</text>
      </view>

      <view class="stock-sub">
        <view class="stock-sub-item">
          <text class="stock-sub-num">¥{{stockAmount}}</text>
          <text class="stock-sub-label">库存金额</text>
        </view>
        <view class="stock-sub-divider"></view>
        <view class="stock-sub-item">
          <text class="stock-sub-num">{{product.minQuantity || 0}}</text>
          <text class="stock-sub-label">最低库存</text>
        </view>
      </view>
    </view>

    <!-- ===== 商品信息卡片 ===== -->
    <view class="section-card">
      <view class="section-header">
        <view class="section-header-left">
          <view class="section-icon section-icon-info"></view>
          <text class="section-title">商品信息</text>
        </view>
      </view>

      <view class="attr-item">
        <text class="attr-label">规格型号</text>
        <text class="attr-val">{{product.spec || '-'}}</text>
      </view>
      <view class="attr-item">
        <text class="attr-label">单位</text>
        <text class="attr-val">{{product.unitName || '-'}}</text>
      </view>
      <view class="attr-item">
        <text class="attr-label">批准文号</text>
        <text class="attr-val">{{product.approvalNo || '-'}}</text>
      </view>
      <view class="attr-item">
        <text class="attr-label">生产企业</text>
        <text class="attr-val">{{product.manufacturer || '-'}}</text>
      </view>
      <view class="attr-item">
        <text class="attr-label">参考售价</text>
        <text class="attr-val attr-price">¥{{product.price}}</text>
      </view>
    </view>

    <!-- ===== 仓库分布卡片 ===== -->
    <view class="section-card" wx:if="{{warehouses.length > 0}}">
      <view class="section-header">
        <view class="section-header-left">
          <view class="section-icon section-icon-warehouse"></view>
          <text class="section-title">仓库分布</text>
        </view>
        <view class="count-badge">
          <text class="count-badge-num">{{warehouses.length}}</text>
          <text class="count-badge-label">个仓位</text>
        </view>
      </view>

      <view class="wh-list">
        <view class="wh-item" wx:for="{{warehouses}}" wx:key="index">
          <view class="wh-left">
            <text class="wh-name">{{item.warehouse.name || '-'}}</text>
            <text class="wh-loc" wx:if="{{item.location.name}}">{{item.location.name}}</text>
          </view>
          <view class="wh-right">
            <text class="wh-num">{{item.quantity}}</text>
            <text class="wh-unit">{{product.unitName || '件'}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- ===== 批次信息卡片 ===== -->
    <view class="section-card" wx:if="{{batches.length > 0}}">
      <view class="section-header section-header-toggle" bindtap="onToggleBatches">
        <view class="section-header-left">
          <view class="section-icon section-icon-batch"></view>
          <text class="section-title">批次信息</text>
        </view>
        <view class="section-header-right">
          <view class="count-badge">
            <text class="count-badge-num">{{batches.length}}</text>
            <text class="count-badge-label">批</text>
          </view>
          <view class="toggle-arrow {{showBatches ? 'expanded' : ''}}"></view>
        </view>
      </view>

      <view class="batch-list" wx:if="{{showBatches}}">
        <view class="batch-card" wx:for="{{batches}}" wx:key="id">
          <view class="batch-top">
            <view class="batch-code-wrap">
              <text class="batch-code-label">批次</text>
              <text class="batch-code">{{item.batchCode}}</text>
            </view>
            <view class="batch-qty-wrap">
              <text class="batch-qty-num">{{item.quantity}}</text>
              <text class="batch-qty-unit">{{product.unitName || '件'}}</text>
            </view>
          </view>
          <view class="batch-detail">
            <view class="batch-detail-item">
              <text class="batch-detail-label">批号</text>
              <text class="batch-detail-value">{{item.batchNo}}</text>
            </view>
            <view class="batch-detail-item" wx:if="{{item.price}}">
              <text class="batch-detail-label">进价</text>
              <text class="batch-detail-value">¥{{item.price}}</text>
            </view>
            <view class="batch-detail-item" wx:if="{{item.productionDate}}">
              <text class="batch-detail-label">生产</text>
              <text class="batch-detail-value">{{item.productionDate}}</text>
            </view>
            <view class="batch-detail-item" wx:if="{{item.expiryDate}}">
              <text class="batch-detail-label">效期</text>
              <text class="batch-detail-value">{{item.expiryDate}}</text>
            </view>
            <view class="batch-detail-item" wx:if="{{item.locationCode}}">
              <text class="batch-detail-label">货位</text>
              <text class="batch-detail-value">{{item.locationCode}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- ===== 出入库记录卡片 ===== -->
    <view class="section-card" wx:if="{{logs.length > 0}}">
      <view class="section-header section-header-toggle" bindtap="onToggleLogs">
        <view class="section-header-left">
          <view class="section-icon section-icon-logs"></view>
          <text class="section-title">出入库记录</text>
        </view>
        <view class="section-header-right">
          <view class="toggle-arrow {{showLogs ? 'expanded' : ''}}"></view>
        </view>
      </view>

      <view class="log-list" wx:if="{{showLogs}}">
        <view class="log-item" wx:for="{{logs}}" wx:key="id">
          <view class="log-left">
            <text class="log-tag log-tag-{{item.tagClass}}">{{item.tagLabel}}</text>
            <view class="log-info">
              <text class="log-title">{{item.tagTitle}}</text>
              <text class="log-time">{{item.timeDisplay}}</text>
            </view>
          </view>
          <text class="log-qty qty-{{item.qtyClass}}">{{item.qtyDisplay}}</text>
        </view>
      </view>
    </view>

    <!-- 暂无记录 -->
    <view class="section-card" wx:if="{{logs.length === 0}}">
      <view class="section-header">
        <view class="section-header-left">
          <view class="section-icon section-icon-logs"></view>
          <text class="section-title">出入库记录</text>
        </view>
      </view>
      <text class="empty-hint">暂无记录</text>
    </view>

    <!-- ===== 底部操作栏 ===== -->
    <view class="bottom-bar">
      <button class="btn-edit" bindtap="onEdit">编辑商品</button>
    </view>

  </block>

</view>
