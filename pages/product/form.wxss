/* ============================================================
   UI-UX PRO MAX — 商品信息（新增/编辑）
   ============================================================ */

/* ---------- 基础 ---------- */
.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 0 0 200rpx;
}

.placeholder {
  color: #cccccc;
  font-size: 26rpx;
}

/* ---------- 页面头部 ---------- */
.page-header {
  background: linear-gradient(135deg, #F59E0B 0%, #F97316 100%);
  padding: 40rpx 32rpx 56rpx;
  border-radius: 0 0 40rpx 40rpx;
}

.page-header-title {
  display: block;
  font-size: 38rpx;
  font-weight: 700;
  color: #FFFFFF;
  letter-spacing: 1rpx;
}

.page-header-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.75);
}

/* ---------- 卡片通用 ---------- */
.section-card {
  margin: -24rpx 20rpx 28rpx;
  background: #FFFFFF;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
  padding: 24rpx 24rpx;
  position: relative;
  z-index: 2;
}

.section-card:first-of-type {
  margin-top: -24rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.section-header-left {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.section-icon {
  width: 32rpx;
  height: 32rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}

.section-icon-info {
  background: linear-gradient(135deg, #F59E0B, #F97316);
}

.section-icon-price {
  background: linear-gradient(135deg, #10B981, #34D399);
}

.section-icon-other {
  background: linear-gradient(135deg, #8B5CF6, #A78BFA);
}

.section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #333333;
}

/* ---------- 表单项 ---------- */
.form-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f5f5f5;
}

.form-item:last-child {
  border-bottom: none;
}

/* 主角字段：商品名称 */
.form-item-highlight {
  background: #FFFBEB;
  margin: 0 -24rpx;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  border-bottom: 2rpx solid #f5f5f5;
}

.form-label {
  font-size: 28rpx;
  font-weight: 500;
  color: #333333;
  flex-shrink: 0;
  margin-right: 20rpx;
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.required {
  color: #EF4444;
  font-size: 28rpx;
  font-weight: 400;
}

/* ===== 带快速添加按钮的表单项 ===== */
.form-item-with-btn {
  overflow: visible;
}

.picker-with-btn {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
  min-width: 0;
}

.picker-with-btn > picker {
  flex: 1;
  min-width: 0;
}

.btn-add-inline {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #EEF4FF;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.btn-add-inline:active {
  background: #D6E4FF;
}

.btn-add-inline-icon {
  font-size: 30rpx;
  color: #0077C2;
  font-weight: 700;
  line-height: 1;
}

/* ===== 内联新增输入区域 ===== */
.inline-add {
  overflow: hidden;
  max-height: 0;
  transition: max-height 0.25s ease;
}

.inline-add-open {
  max-height: 160rpx;
}

.inline-add-inner {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 0 16rpx 140rpx;
  border-bottom: 2rpx solid #f5f5f5;
}

.inline-add-input {
  flex: 1;
  height: 64rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  padding: 0 16rpx;
  font-size: 26rpx;
  color: #333;
  min-width: 0;
}

.inline-add-actions {
  display: flex;
  gap: 10rpx;
  flex-shrink: 0;
}

.inline-add-btn {
  height: 64rpx;
  padding: 0 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8rpx;
  font-size: 26rpx;
  font-weight: 500;
}

.inline-add-cancel {
  background: #f5f5f5;
  color: #5c5c5c;
}

.inline-add-cancel:active {
  background: #eee;
}

.inline-add-confirm {
  background: #0077C2;
  color: #fff;
}

.inline-add-confirm:active {
  opacity: 0.85;
}

.form-input {
  flex: 1;
  text-align: right;
  font-size: 26rpx;
  color: #333333;
  height: 80rpx;
  line-height: 80rpx;
}

/* ---------- 带前缀的输入框（¥） ---------- */
.input-with-prefix {
  display: flex;
  align-items: center;
  flex: 1;
  justify-content: flex-end;
}

.input-prefix {
  font-size: 28rpx;
  font-weight: 600;
  color: #5c5c5c;
  margin-right: 6rpx;
}

.input-with-prefix .form-input {
  flex: none;
  width: 200rpx;
}

/* ---------- 只读文本（自动编码） ---------- */
.form-readonly {
  flex: 1;
  text-align: right;
  font-size: 26rpx;
  color: #5c5c5c;
  line-height: 80rpx;
}

.form-auto-code {
  color: #cccccc;
  font-style: italic;
}

/* ---------- Picker 选择器 ---------- */
.form-picker {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  text-align: right;
  font-size: 26rpx;
  color: #333333;
  height: 80rpx;
  line-height: 80rpx;
}

.picker-arrow {
  width: 10rpx;
  height: 10rpx;
  border-right: 3rpx solid #cccccc;
  border-bottom: 3rpx solid #cccccc;
  transform: rotate(45deg);
  margin-left: 12rpx;
  margin-top: -4rpx;
  flex-shrink: 0;
}

/* ---------- 底部操作栏 ---------- */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #FFFFFF;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #cccccc;
  z-index: 100;
}

.btn-save {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #F59E0B;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 8rpx;
  border: none;
  text-align: center;
  letter-spacing: 1rpx;
}

.btn-save[disabled] {
  background: #cccccc;
  color: rgba(255, 255, 255, 0.7);
}
