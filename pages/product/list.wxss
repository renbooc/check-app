.page {
  padding-bottom: 48rpx;
  min-height: 100vh;
  background: #f5f5f5;
}

.search-bar {
  padding: 20rpx 36rpx;
}

.search-input-wrap {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.68);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-radius: 20rpx;
  padding: 0 24rpx;
  height: 80rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.5);
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.search-input {
  width: 100%;
  height: 100%;
  font-size: 28rpx;
  color: #333333;
}

.product-list {
  padding: 0 36rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.product-card {
  background: rgba(255, 255, 255, 0.68);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-radius: 20rpx;
  padding: 28rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.5);
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
  transition: transform 0.2s;
}

.product-card:active {
  transform: scale(0.99);
}

.product-main {
  display: flex;
  align-items: center;
}

.product-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.product-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 6rpx;
}

.product-code {
  font-size: 22rpx;
  color: #5c5c5c;
}

.product-meta {
  display: flex;
  align-items: baseline;
  margin-right: 16rpx;
}

.product-price {
  font-size: 28rpx;
  font-weight: 600;
  color: #ff4d4f;
}

.product-unit {
  font-size: 22rpx;
  color: #5c5c5c;
}

.fab {
  position: fixed;
  right: 40rpx;
  bottom: 60rpx;
  width: 100rpx;
  height: 100rpx;
  background: #0077C2;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
}

.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-text {
  font-size: 26rpx;
  color: #5c5c5c;
}
