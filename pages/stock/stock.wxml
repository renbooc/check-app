<view class="page">

  <!-- ====== 搜索栏 ====== -->
  <view class="search-card">
    <view class="search-input-wrap">
      <image class="search-icon" src="/images/icon-search.png" mode="aspectFit"></image>
      <input class="search-input" placeholder="搜索药品名称/条码" value="{{searchKeyword}}" bindinput="onSearchInput" bindconfirm="onSearch" />
      <view class="clear-btn" wx:if="{{searchKeyword}}" bindtap="onClearSearch">
        <text>✕</text>
      </view>
    </view>
    <view class="scan-btn" bindtap="onScanCode">
      <image class="scan-icon" src="/images/icon-scan.png" mode="aspectFit"></image>
    </view>
  </view>

  <!-- ====== Loading ====== -->
  <view class="loading-wrap" wx:if="{{pageLoading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <!-- ====== 空状态 ====== -->
  <view class="empty-wrap" wx:elif="{{stockList.length === 0}}">
    <image class="empty-img" src="/images/icon-stock.png" mode="aspectFit"></image>
    <text class="empty-text">暂无库存数据</text>
    <text class="empty-hint">请先添加商品或进行采购入库</text>
  </view>

  <!-- ====== 库存列表 ====== -->
  <block wx:else>
    <view class="list-header">
      <text class="list-count">共 {{total}} 条记录</text>
    </view>

    <view class="stock-list">
      <view class="stock-card" wx:for="{{stockList}}" wx:key="id" bindtap="onItemTap" data-id="{{item.id}}">
        <!-- 顶部：名称 + 规格 -->
        <view class="card-top">
          <view class="card-info">
            <text class="card-name">{{item.product.name}}</text>
            <text class="card-spec">{{item.product.spec}} / {{item.product.unit ? item.product.unit.name : ''}}</text>
            <text class="card-manufacturer">{{item.product.manufacturer || '-'}}</text>
          </view>
          <view class="card-qty">
            <text class="qty-num">{{item.quantity}}</text>
            <text class="qty-unit">{{item.product.unit ? item.product.unit.name : ''}}</text>
          </view>
        </view>
        <!-- 底部：编号 -->
        <view class="card-meta">
          <view class="meta-item">
            <text class="meta-label">编号</text>
            <text class="meta-value">{{item.product.code}}</text>
          </view>
        </view>
      </view>
    </view>
  </block>

  <!-- ====== 库存详情弹层 ====== -->
  <view class="detail-mask" wx:if="{{showDetail}}" bindtap="onCloseDetail"></view>
  <view class="detail-panel {{showDetail ? 'visible' : ''}}">
    <view class="detail-header">
      <text class="detail-title">库存详情</text>
      <view class="detail-close" bindtap="onCloseDetail">
        <text>✕</text>
      </view>
    </view>
    <block wx:if="{{detailProduct}}">
      <scroll-view class="detail-body" scroll-y enhanced show-scrollbar="{{false}}">
        <!-- ====== 商品概要 ====== -->
        <view class="product-hero">
          <view class="hero-top">
            <view class="hero-info">
              <text class="hero-name">{{detailProduct.product.name}}</text>
              <text class="hero-spec">{{detailProduct.product.spec}} / {{detailProduct.product.unit ? detailProduct.product.unit.name : ''}}</text>
              <text class="hero-manufacturer">{{detailProduct.product.manufacturer || '-'}}</text>
            </view>
            <view class="hero-qty">
              <text class="hero-qty-num">{{detailProduct.quantity}}</text>
              <text class="hero-qty-unit">{{detailProduct.product.unit ? detailProduct.product.unit.name : '件'}}</text>
            </view>
          </view>
        </view>

        <!-- ====== 基本信息网格 ====== -->
        <view class="info-grid">
          <view class="info-cell">
            <text class="info-cell-label">编号</text>
            <text class="info-cell-value">{{detailProduct.product.code}}</text>
          </view>
          <view class="info-cell">
            <text class="info-cell-label">仓库</text>
            <text class="info-cell-value">{{detailProduct.warehouse ? detailProduct.warehouse.name : '-'}}</text>
          </view>
        </view>

        <!-- ====== 批次明细 ====== -->
        <view class="batch-section">
          <view class="batch-header">
            <text class="batch-title">批次明细</text>
            <text class="batch-count">{{detailProduct.batches.length}} 批</text>
          </view>

          <view wx:if="{{detailProduct.batches.length === 0}}" class="batch-empty">
            <text>暂无批次数据</text>
          </view>

          <view class="batch-table" wx:else>
            <!-- 表头 -->
            <view class="batch-thead">
              <text class="th th-batch">批号</text>
              <text class="th th-date">生产日期</text>
              <text class="th th-date">有效期</text>
              <text class="th th-loc">库位</text>
              <text class="th th-qty">数量</text>
              <text class="th th-price">单价</text>
            </view>
            <!-- 行 -->
            <view class="batch-trow" wx:for="{{detailProduct.batches}}" wx:key="id">
              <text class="td td-batch">{{item.batchNo}}</text>
              <text class="td td-date">{{item.productionDate || '-'}}</text>
              <text class="td td-date">{{item.expiryDate || '-'}}</text>
              <text class="td td-loc">{{item.locationCode || '-'}}</text>
              <text class="td td-qty">{{item.quantity}}</text>
              <text class="td td-price">¥{{item.price}}</text>
            </view>
          </view>
        </view>
      </scroll-view>

      <view class="detail-footer">
        <button class="detail-btn" bindtap="onGoCheck" data-id="{{detailProduct.id}}">去盘点</button>
      </view>
    </block>
  </view>

</view>
