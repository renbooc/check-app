/* ============================================================
   库存查询页 — 企业级库存管理
   背景 #f5f5f5 / 卡片 #FFFFFF / 主色 #0077C2
   ============================================================ */

.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

/* ============================================================
   搜索栏（白卡片 + 搜索图标 + 扫码按钮）
   ============================================================ */
.search-card {
  background: #FFFFFF;
  margin: 24rpx 24rpx 0;
  padding: 16rpx 16rpx 16rpx 24rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.search-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  min-width: 0;
}

.search-icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
  margin-right: 16rpx;
  opacity: 0.4;
}

.search-input {
  flex: 1;
  font-size: 26rpx;
  color: #333333;
  min-width: 0;
}

.clear-btn {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-left: 8rpx;
}

.clear-btn text {
  font-size: 24rpx;
  color: #cccccc;
}

.scan-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: rgba(0, 119, 194, 0.06);
  border-radius: 12rpx;
}

.scan-btn:active {
  background: rgba(0, 119, 194, 0.12);
}

.scan-icon {
  width: 36rpx;
  height: 36rpx;
}

/* ============================================================
   Loading
   ============================================================ */
.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 0;
  gap: 20rpx;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #f5f5f5;
  border-top-color: #0077C2;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 24rpx;
  color: #5c5c5c;
}

/* ============================================================
   空状态
   ============================================================ */
.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 48rpx;
}

.empty-img {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 32rpx;
  opacity: 0.3;
}

.empty-text {
  font-size: 28rpx;
  color: #5c5c5c;
  font-weight: 500;
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: #cccccc;
}

/* ============================================================
   列表头部
   ============================================================ */
.list-header {
  padding: 32rpx 32rpx 16rpx;
}

.list-count {
  font-size: 24rpx;
  color: #5c5c5c;
  font-weight: 500;
}

/* ============================================================
   库存卡片列表
   ============================================================ */
.stock-list {
  padding: 0 24rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.stock-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 28rpx 28rpx 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.stock-card:active {
  background: #fafafa;
}

/* ---------- 卡片顶部（名称 + 库存量） ---------- */
.card-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.card-info {
  flex: 1;
  min-width: 0;
  margin-right: 20rpx;
}

.card-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 10rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-spec {
  display: block;
  font-size: 22rpx;
  color: #5c5c5c;
}

/* 库存量（视觉焦点） */
.card-qty {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  flex-shrink: 0;
}

.qty-num {
  font-size: 48rpx;
  font-weight: 700;
  color: #0077C2;
  line-height: 1;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', sans-serif;
}

.qty-unit {
  font-size: 20rpx;
  color: #5c5c5c;
  margin-top: 8rpx;
}

/* ---------- 卡片底部元信息 ---------- */
.card-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f5f5f5;
}

.meta-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.meta-label {
  font-size: 20rpx;
  color: #cccccc;
}

.meta-value {
  font-size: 22rpx;
  color: #5c5c5c;
}

/* ============================================================
   库存详情弹层（底部滑出面板）
   ============================================================ */
.detail-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 100;
  opacity: 1;
  transition: opacity 0.3s;
}

.detail-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #FFFFFF;
  border-radius: 24rpx 24rpx 0 0;
  z-index: 101;
  transform: translateY(100%);
  transition: transform 0.3s ease-out;
  max-height: 80vh;
  display: flex;
  flex-direction: column;
}

.detail-panel.visible {
  transform: translateY(0);
}

.detail-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 32rpx 24rpx;
  border-bottom: 1rpx solid #f5f5f5;
  flex-shrink: 0;
}

.detail-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #333333;
}

.detail-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #f5f5f5;
}

.detail-close text {
  font-size: 28rpx;
  color: #5c5c5c;
}

.detail-body {
  padding: 24rpx 32rpx;
  overflow-y: auto;
  flex: 1;
}

.detail-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.detail-row:last-child {
  border-bottom: none;
}

.detail-label {
  font-size: 26rpx;
  color: #5c5c5c;
  flex-shrink: 0;
}

.detail-value {
  font-size: 26rpx;
  color: #333333;
  font-weight: 500;
  text-align: right;
  margin-left: 24rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.detail-value.highlight {
  color: #0077C2;
  font-weight: 700;
  font-size: 32rpx;
}

/* ===== 批次明细 ===== */
.detail-section-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
  padding: 24rpx 0 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.batch-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 16rpx 0;
}

.batch-item {
  background: #fafafa;
  border-radius: 12rpx;
  padding: 20rpx;
}

.batch-item-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.batch-item-row:last-child {
  margin-bottom: 0;
}

.batch-field {
  flex: 1;
  min-width: 0;
}

.batch-label {
  display: block;
  font-size: 20rpx;
  color: #999;
  margin-bottom: 4rpx;
}

.batch-value {
  display: block;
  font-size: 24rpx;
  color: #333;
  font-weight: 500;
}

.detail-footer {
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #f5f5f5;
  flex-shrink: 0;
}

.detail-btn {
  width: 100%;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #0077C2;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 16rpx;
  border: none;
}

.detail-btn:active {
  background: #005a8e;
}
