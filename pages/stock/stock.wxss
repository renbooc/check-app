/* ============================================================
   库存查询页 — 企业级库存管理
   背景 #f5f5f5 / 卡片 #FFFFFF / 主色 #0077C2
   ============================================================ */

.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

/* ============================================================
   搜索栏（白卡片 + 搜索图标 + 扫码按钮）
   ============================================================ */
.search-card {
  background: #FFFFFF;
  margin: 24rpx 24rpx 0;
  padding: 16rpx 16rpx 16rpx 24rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.search-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  min-width: 0;
}

.search-icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
  margin-right: 16rpx;
  opacity: 0.4;
}

.search-input {
  flex: 1;
  font-size: 26rpx;
  color: #333333;
  min-width: 0;
}

.clear-btn {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-left: 8rpx;
}

.clear-btn text {
  font-size: 24rpx;
  color: #cccccc;
}

.scan-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: rgba(0, 119, 194, 0.06);
  border-radius: 12rpx;
}

.scan-btn:active {
  background: rgba(0, 119, 194, 0.12);
}

.scan-icon {
  width: 36rpx;
  height: 36rpx;
}

/* ============================================================
   Loading
   ============================================================ */
.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 0;
  gap: 20rpx;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #f5f5f5;
  border-top-color: #0077C2;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 24rpx;
  color: #5c5c5c;
}

/* ============================================================
   空状态
   ============================================================ */
.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 48rpx;
}

.empty-img {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 32rpx;
  opacity: 0.3;
}

.empty-text {
  font-size: 28rpx;
  color: #5c5c5c;
  font-weight: 500;
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: #cccccc;
}

/* ============================================================
   列表头部
   ============================================================ */
.list-header {
  padding: 32rpx 32rpx 16rpx;
}

.list-count {
  font-size: 24rpx;
  color: #5c5c5c;
  font-weight: 500;
}

/* ============================================================
   库存卡片列表
   ============================================================ */
.stock-list {
  padding: 0 24rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.stock-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 28rpx 28rpx 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.stock-card:active {
  background: #fafafa;
}

/* ---------- 卡片顶部（名称 + 库存量） ---------- */
.card-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.card-info {
  flex: 1;
  min-width: 0;
  margin-right: 20rpx;
}

.card-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 10rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-spec {
  display: block;
  font-size: 22rpx;
  color: #5c5c5c;
  margin-bottom: 6rpx;
}

.card-manufacturer {
  display: block;
  font-size: 20rpx;
  color: #999;
}

/* 库存量（视觉焦点） */
.card-qty {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  flex-shrink: 0;
}

.qty-num {
  font-size: 48rpx;
  font-weight: 700;
  color: #0077C2;
  line-height: 1;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', sans-serif;
}

.qty-unit {
  font-size: 20rpx;
  color: #5c5c5c;
  margin-top: 8rpx;
}

/* ---------- 卡片底部元信息 ---------- */
.card-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f5f5f5;
}

.meta-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.meta-label {
  font-size: 20rpx;
  color: #cccccc;
}

.meta-value {
  font-size: 22rpx;
  color: #5c5c5c;
}

/* ============================================================
   库存详情弹层（底部滑出面板）
   ============================================================ */
.detail-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 100;
  opacity: 1;
  transition: opacity 0.3s;
}

.detail-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #FFFFFF;
  border-radius: 24rpx 24rpx 0 0;
  z-index: 101;
  transform: translateY(100%);
  transition: transform 0.3s ease-out;
  max-height: 85vh;
  display: flex;
  flex-direction: column;
}

.detail-panel.visible {
  transform: translateY(0);
}

.detail-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
  flex-shrink: 0;
}

.detail-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a1a;
}

.detail-close {
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #f5f5f5;
}

.detail-close text {
  font-size: 26rpx;
  color: #999;
}

/* ====== 商品概要 hero ====== */
.detail-body {
  flex: 1;
  overflow-y: auto;
}

.product-hero {
  padding: 24rpx 32rpx 20rpx;
  border-bottom: 16rpx solid #f5f5f5;
}

.hero-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.hero-info {
  flex: 1;
  min-width: 0;
  margin-right: 24rpx;
}

.hero-name {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #1a1a1a;
  line-height: 1.3;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.hero-spec {
  display: block;
  font-size: 24rpx;
  color: #888;
  margin-bottom: 6rpx;
}

.hero-manufacturer {
  display: block;
  font-size: 22rpx;
  color: #aaa;
}

.hero-qty {
  text-align: center;
  flex-shrink: 0;
  background: linear-gradient(135deg, #0077C2, #0099e6);
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.hero-qty-num {
  display: block;
  font-size: 40rpx;
  font-weight: 800;
  color: #fff;
  line-height: 1;
}

.hero-qty-unit {
  display: block;
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 4rpx;
}

/* ====== 信息网格 ====== */
.info-grid {
  display: flex;
  padding: 20rpx 32rpx;
  border-bottom: 16rpx solid #f5f5f5;
}

.info-cell {
  flex: 1;
}

.info-cell-label {
  display: block;
  font-size: 22rpx;
  color: #bbb;
  margin-bottom: 6rpx;
}

.info-cell-value {
  display: block;
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

/* ====== 批次明细 ====== */
.batch-section {
  padding: 24rpx 32rpx 8rpx;
}

.batch-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.batch-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.batch-count {
  font-size: 22rpx;
  color: #999;
  background: #f5f5f5;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.batch-empty {
  text-align: center;
  padding: 40rpx 0;
  font-size: 24rpx;
  color: #ccc;
}

/* ====== 批次表格 ====== */
.batch-table {
  border: 1rpx solid #f0f0f0;
  border-radius: 12rpx;
  overflow: hidden;
}

.batch-thead {
  display: flex;
  background: #fafafa;
  padding: 16rpx 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.batch-trow {
  display: flex;
  padding: 16rpx 20rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.batch-trow:last-child {
  border-bottom: none;
}

.th, .td {
  font-size: 24rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.th {
  color: #999;
  font-weight: 500;
}

.td {
  color: #333;
}

.th-batch, .td-batch { flex: 1.2; min-width: 0; }
.th-date, .td-date { flex: 1; min-width: 0; text-align: center; }
.th-loc, .td-loc { flex: 0.8; min-width: 0; text-align: center; }
.th-qty, .td-qty { flex: 0.6; min-width: 0; text-align: right; }
.th-price, .td-price { flex: 0.8; min-width: 0; text-align: right; }

.detail-footer {
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #f0f0f0;
  flex-shrink: 0;
}

.detail-btn {
  width: 100%;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #0077C2;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 16rpx;
  border: none;
}

.detail-btn:active {
  background: #005a8e;
}
