/* ============================================================
   系统设置 — 简洁卡片式布局
   背景 #f5f5f5 / 卡片 #FFFFFF / 主色 #0077C2
   ============================================================ */

.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 0 24rpx 60rpx;
}

/* ===== 页面头部（渐变标题卡，与消息页/采购表单统一设计语言） ===== */
.page-header {
  background: linear-gradient(135deg, #0077C2 0%, #59a5f5 100%);
  padding: 40rpx 32rpx;
  border-radius: 16rpx;
  margin: 24rpx 0 32rpx;
  position: relative;
  overflow: hidden;
}

.page-header::after {
  content: '';
  position: absolute;
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.06);
  top: -80rpx;
  right: -60rpx;
  pointer-events: none;
}

.page-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 8rpx;
  position: relative;
  z-index: 1;
}

.page-sub {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.75);
  position: relative;
  z-index: 1;
}

/* ===== 卡片 ===== */
.card {
  background: #FFFFFF;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  margin-bottom: 24rpx;
  overflow: hidden;
}

.card-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 28rpx 28rpx 0;
}

.card-icon {
  width: 36rpx;
  height: 36rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}

.card-icon-cache {
  background: linear-gradient(135deg, #0077C2, #59a5f5);
}

.card-icon-about {
  background: linear-gradient(135deg, #10B981, #34D399);
}

.card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.card-body {
  padding: 16rpx 0 8rpx;
}

/* ===== 设置行 ===== */
.setting-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
  min-height: 72rpx;
}

.setting-row:active {
  background: #f8f8f8;
}

.setting-left {
  flex: 1;
  min-width: 0;
}

.setting-label {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
}

.setting-desc {
  display: block;
  font-size: 22rpx;
  color: #999999;
  margin-top: 4rpx;
}

.setting-value {
  font-size: 26rpx;
  color: #999;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.setting-arrow {
  font-size: 36rpx;
  color: #ddd;
  font-weight: 300;
  flex-shrink: 0;
  margin-left: 8rpx;
  line-height: 1;
}

/* ===== 底部版本 ===== */
.footer-text {
  text-align: center;
  padding: 40rpx 0;
  font-size: 22rpx;
  color: #999999;
}
