<view class="page">
  <view class="menu-group">
    <view class="menu-title">服务器配置</view>
    <view class="menu-item">
      <text class="menu-label">API 地址</text>
      <text class="menu-value">{{serverUrl}}</text>
    </view>
  </view>

  <view class="menu-group">
    <view class="menu-title">缓存管理</view>
    <view class="menu-item" bindtap="onClearCache">
      <text class="menu-label">清除缓存</text>
      <icon-cmp type="arrow-right" size="14" color="#CCCCCC"></icon-cmp>
    </view>
  </view>

  <view class="menu-group">
    <view class="menu-title">关于</view>
    <view class="menu-item">
      <text class="menu-label">版本号</text>
      <text class="menu-value">v{{version}}</text>
    </view>
  </view>
</view>
