<view class="page">

  <!-- Loading -->
  <view class="loading-wrap" wx:if="{{loading}}">
    <view class="loading-dot"></view>
  </view>

  <block wx:elif="{{loaded}}">

    <!-- ====== 顶部渐变标题区 ====== -->
    <view class="page-header">
      <view class="header-deco"></view>
      <view class="header-row">
        <view class="header-left">
          <text class="page-title">消息通知</text>
          <text class="page-subtitle">查看系统消息与通知</text>
        </view>
        <text class="mark-all-btn" wx:if="{{showMarkAll}}" bindtap="onMarkAllRead">全部已读</text>
      </view>
    </view>

    <!-- ====== 消息列表 ====== -->
    <view class="msg-list" wx:if="{{!showEmpty}}">
      <view
        wx:for="{{list}}"
        wx:key="id"
        class="{{item.itemCls}}"
        bindtap="onItemTap"
        data-id="{{item.id}}"
        data-index="{{index}}"
      >
        <!-- 左侧类型色带 -->
        <view class="msg-stripe {{item.typeCls}}"></view>
        <!-- 消息内容 -->
        <view class="msg-body">
          <view class="msg-title-row">
            <text class="msg-item-title">{{item.title}}</text>
            <view class="{{item.dotCls}}"></view>
          </view>
          <text class="msg-item-content">{{item.content}}</text>
          <text class="msg-item-time">{{item.timeText}}</text>
        </view>
      </view>
    </view>

    <!-- ====== 空态 ====== -->
    <view class="empty-wrap" wx:if="{{showEmpty}}">
      <view class="empty-icon">
        <view class="empty-bell"></view>
      </view>
      <text class="empty-title">{{emptyText}}</text>
      <text class="empty-hint">所有通知将在这里显示</text>
    </view>

  </block>

</view>
