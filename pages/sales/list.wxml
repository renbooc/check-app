<view class="page">

  <!-- ========== 搜索栏 ========== -->
  <view class="search-bar">
    <view class="search-box">
      <view class="search-icon"></view>
      <input class="search-input" placeholder="搜索销售单号/客户" value="{{keyword}}" bindinput="onSearchInput" bindconfirm="onSearch" confirm-type="search" />
      <view class="search-clear" wx:if="{{keyword}}" bindtap="onClearSearch">
        <view class="clear-icon"></view>
      </view>
    </view>
  </view>

  <!-- ========== 状态标签切换 ========== -->
  <view class="status-tabs">
    <view class="status-tab {{currentStatus === '' ? 'active' : ''}}" bindtap="onStatusFilter" data-status="">
      <text>全部</text>
    </view>
    <view class="status-tab {{currentStatus === 'draft' ? 'active' : ''}}" bindtap="onStatusFilter" data-status="draft">
      <text>草稿</text>
    </view>
    <view class="status-tab {{currentStatus === 'pending' ? 'active' : ''}}" bindtap="onStatusFilter" data-status="pending">
      <text>待审核</text>
    </view>
    <view class="status-tab {{currentStatus === 'approved' ? 'active' : ''}}" bindtap="onStatusFilter" data-status="approved">
      <text>已审核</text>
    </view>
    <view class="status-tab {{currentStatus === 'delivered' ? 'active' : ''}}" bindtap="onStatusFilter" data-status="delivered">
      <text>已出库</text>
    </view>
  </view>

  <!-- ========== 内容区域 ========== -->
  <view class="content-area">

    <!-- 加载骨架 -->
    <view class="skeleton-wrap" wx:if="{{loading && list.length === 0}}">
      <view class="skeleton-card" wx:for="{{[1,2,3]}}" wx:key="*this">
        <view class="skeleton-row">
          <view class="skeleton-avatar"></view>
          <view class="skeleton-lines">
            <view class="skeleton-line skeleton-name"></view>
            <view class="skeleton-line skeleton-phone"></view>
          </view>
        </view>
      </view>
    </view>

    <!-- 搜索为空 -->
    <view class="empty-wrap" wx:elif="{{searched && list.length === 0}}">
      <view class="empty-icon-wrap">
        <view class="empty-icon-search"></view>
      </view>
      <text class="empty-title">未找到匹配订单</text>
      <text class="empty-desc">试试其他关键词</text>
    </view>

    <!-- 数据为空 -->
    <view class="empty-wrap" wx:elif="{{!loading && !searched && list.length === 0 && loaded}}">
      <view class="empty-icon-wrap">
        <view class="empty-icon-box"></view>
      </view>
      <text class="empty-title">暂无销售订单</text>
      <text class="empty-desc">点击下方按钮创建首张销售订单</text>
    </view>

    <!-- 列表 -->
    <view class="list-wrap" wx:else>
      <view class="list-card" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}">
        <view class="card-inner" bindtap="onDetail" data-id="{{item.id}}">
          <view class="card-left">
            <view class="card-avatar avatar-sales">{{item.initial}}</view>
          </view>
          <view class="card-body">
            <view class="card-name-row">
              <text class="card-name">{{item.customerName}}</text>
              <view class="status-tag tag-{{item.statusCls}}">{{item.statusLabel}}</view>
            </view>
            <view class="card-info-row" wx:if="{{item.orderNo}}">
              <view class="info-icon-order"></view>
              <text class="card-info-text">{{item.orderNo}}</text>
            </view>
            <view class="card-info-row" wx:if="{{item.totalQuantity}}">
              <view class="info-icon-qty"></view>
              <text class="card-info-text">{{item.totalQuantity}} 件 · ¥{{item.totalAmount}}</text>
            </view>
          </view>
        </view>
        <view class="card-action" wx:if="{{item.statusCls === 'approved'}}" catchtap="onQuickDeliver" data-id="{{item.id}}">
          <text class="card-action-text">确认出库</text>
        </view>
      </view>

      <view class="load-more" wx:if="{{list.length > 0 && list.length < total}}">
        <text class="load-more-text">上拉加载更多</text>
      </view>
      <view class="load-more" wx:elif="{{list.length > 0 && list.length >= total && total > 0}}">
        <text class="load-more-text">— 已显示全部 {{total}} 单 —</text>
      </view>
    </view>

  </view>

  <!-- ========== 底部操作栏 ========== -->
  <view class="bottom-action">
    <view class="action-inner">
      <view class="action-count">
        <text class="count-num">{{pendingCount}}</text>
        <text class="count-label">单待审核</text>
      </view>
      <view class="action-btn action-btn-sales" bindtap="onCreate">
        <view class="btn-plus"></view>
        <text>新增销售</text>
      </view>
    </view>
  </view>

</view>
