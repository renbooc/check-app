.page {
  padding: 36rpx;
  min-height: 100vh;
  background: #f5f5f5;
}

.about-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 72rpx 0 56rpx;
  background: rgba(255, 255, 255, 0.68);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-radius: 24rpx;
  margin-bottom: 28rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.5);
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.logo-wrap {
  width: 120rpx;
  height: 120rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #0077C2 0%, #59a5f5 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.logo-text {
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
}

.app-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #333333;
  margin-bottom: 8rpx;
}

.app-version {
  font-size: 24rpx;
  color: #5c5c5c;
}

.info-card {
  background: rgba(255, 255, 255, 0.68);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-radius: 24rpx;
  padding: 28rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.5);
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.info-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.04);
}

.info-item:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 26rpx;
  color: #5c5c5c;
  display: block;
  margin-bottom: 10rpx;
}

.info-value {
  font-size: 28rpx;
  color: #333333;
  line-height: 1.7;
  white-space: pre-line;
}
