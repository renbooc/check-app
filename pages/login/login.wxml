<view class="login-page">
  <!-- 装饰背景元素 -->
  <view class="deco-circles">
    <view class="deco-ring deco-ring-1"></view>
    <view class="deco-ring deco-ring-2"></view>
    <view class="deco-ring deco-ring-3"></view>
  </view>

  <view class="login-header">
    <view class="brand-icon">
      <text class="brand-icon-text">P</text>
    </view>
    <text class="brand-title">博进ERP</text>
    <view class="brand-bar"></view>
  </view>

  <view class="login-card">
    <view class="form-group">
      <text class="form-label">手机号</text>
      <input class="form-input" type="number" maxlength="11" value="{{phone}}" bindinput="onPhoneInput" placeholder="13800138000" />
    </view>

    <view class="form-group">
      <text class="form-label">密码</text>
      <view class="input-wrapper">
        <input wx:if="{{showPassword}}" class="form-input" placeholder="请输入密码" value="{{password}}" bindinput="onPasswordInput" />
        <input wx:else class="form-input" placeholder="请输入密码" password="{{true}}" value="{{password}}" bindinput="onPasswordInput" />
        <view class="toggle-pwd" bindtap="togglePassword">
          <icon-cmp wx:if="{{showPassword}}" type="eye-off" size="18" color="rgba(0,119,194,0.55)" />
          <icon-cmp wx:else type="eye" size="18" color="rgba(0,119,194,0.55)" />
        </view>
      </view>
    </view>

    <button class="login-btn" bindtap="onLogin" loading="{{loading}}" disabled="{{loading}}">
      登录
    </button>

    <!-- 隐私协议 -->
    <view class="agreement-row" bindtap="onToggleAgreement">
      <view class="agreement-checkbox {{agreed ? 'checked' : ''}}">
        <view class="checkbox-inner">
          <icon-cmp wx:if="{{agreed}}" type="check" size="12" color="#ffffff" />
        </view>
      </view>
      <text class="agreement-text">
        已阅读并同意
        <text class="agreement-link" catchtap="onViewPrivacy">《隐私政策》</text>
        <text class="agreement-text-divider">和</text>
        <text class="agreement-link" catchtap="onViewTerms">《用户协议》</text>
      </text>
    </view>

    <view class="login-hint">
      <text class="hint-text">演示账号：13800138000 / 123456</text>
    </view>
  </view>
</view>
