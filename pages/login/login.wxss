.login-page {
  position: relative;
  min-height: 100vh;
  background: linear-gradient(150deg, #E8F4FF 0%, #F0F8FF 50%, #FFFFFF 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 30rpx;
  overflow: hidden;
}

/* ── 装饰背景圆环 ── */
.deco-circles {
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: 0;
}

.deco-ring {
  position: absolute;
  border-radius: 50%;
  border: 2rpx solid;
}

.deco-ring-1 {
  width: 560rpx;
  height: 560rpx;
  top: -200rpx;
  right: -160rpx;
  border-color: rgba(0, 119, 194, 0.12);
  background: radial-gradient(circle, rgba(0, 119, 194, 0.06) 0%, transparent 70%);
}

.deco-ring-2 {
  width: 360rpx;
  height: 360rpx;
  bottom: -80rpx;
  left: -100rpx;
  border-color: rgba(0, 119, 194, 0.08);
  background: radial-gradient(circle, rgba(0, 119, 194, 0.04) 0%, transparent 70%);
}

.deco-ring-3 {
  width: 200rpx;
  height: 200rpx;
  top: 40%;
  right: -60rpx;
  border-color: rgba(89, 165, 245, 0.06);
  background: radial-gradient(circle, rgba(89, 165, 245, 0.03) 0%, transparent 70%);
}

/* ── 品牌区域 ── */
.login-header {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 160rpx;
  margin-bottom: 80rpx;
}

.brand-icon {
  width: 96rpx;
  height: 96rpx;
  background: linear-gradient(135deg, #0077C2, #59a5f5);
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.brand-icon-text {
  font-size: 44rpx;
  font-weight: 700;
  color: #ffffff;
}

.brand-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #333333;
  letter-spacing: 2rpx;
  margin-bottom: 24rpx;
}

.brand-bar {
  width: 80rpx;
  height: 4rpx;
  background: linear-gradient(90deg, #0077C2, #59a5f5);
  border-radius: 2rpx;
}

/* ── 表单卡片（毛玻璃） ── */
.login-card {
  position: relative;
  z-index: 1;
  width: 100%;
  background: rgba(255, 255, 255, 0.65);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  border-radius: 12rpx;
  padding: 52rpx 44rpx;
  box-shadow:
    0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.form-group {
  margin-bottom: 44rpx;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: rgba(0, 0, 0, 0.4);
  margin-bottom: 16rpx;
  letter-spacing: 1rpx;
}

.form-input {
  width: 100%;
  font-size: 32rpx;
  color: #333333;
  height: 80rpx;
  padding: 0;
  background: transparent;
}

.form-input::placeholder {
  color: rgba(0, 0, 0, 0.15);
}

.input-wrapper {
  position: relative;
  border-bottom: 2rpx solid rgba(0, 0, 0, 0.06);
  padding-bottom: 0;
}

.form-group:first-child .form-input {
  border-bottom: 2rpx solid rgba(0, 0, 0, 0.06);
  padding-bottom: 0;
}

.toggle-pwd {
  position: absolute;
  right: 0;
  bottom: 0;
  padding: 20rpx 16rpx;
  min-width: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.toggle-text {
  font-size: 26rpx;
  color: rgba(0, 119, 194, 0.55);
}

/* ── 隐私协议复选框 ── */
.agreement-row {
  display: flex;
  align-items: center;
  margin-top: 36rpx;
  margin-bottom: 24rpx;
}

.agreement-checkbox {
  width: 36rpx;
  height: 36rpx;
  border-radius: 6rpx;
  border: 2rpx solid #cccccc;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 12rpx;
  transition: all 0.2s;
}

.agreement-checkbox.checked {
  background: #0077C2;
  border-color: #0077C2;
}

.checkbox-icon {
  font-size: 24rpx;
  color: #ffffff;
  font-weight: 700;
  line-height: 1;
}

.agreement-text {
  font-size: 24rpx;
  color: #5c5c5c;
  line-height: 1.4;
}

.agreement-link {
  color: #0077C2;
  text-decoration: underline;
}

/* ── 登录按钮 ── */
.login-btn {
  margin-top: 0;
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #0077C2, #59a5f5);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 8rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  letter-spacing: 4rpx;
  box-shadow: none;
}

.login-btn::after {
  border: none;
}

.login-btn[disabled] {
  opacity: 0.5;
}

/* ── 提示 ── */
.login-hint {
  margin-top: 40rpx;
  text-align: center;
}

.hint-text {
  font-size: 24rpx;
  color: rgba(0, 0, 0, 0.25);
}
