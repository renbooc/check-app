.login-page {
  position: relative;
  min-height: 100vh;
  background: linear-gradient(150deg, #E8F4FF 0%, #F0F8FF 50%, #FFFFFF 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 56rpx;
  overflow: hidden;
}

/* ── 装饰背景圆环 ── */
.deco-circles {
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: 0;
}

.deco-ring {
  position: absolute;
  border-radius: 50%;
  border: 2rpx solid;
}

.deco-ring-1 {
  width: 560rpx;
  height: 560rpx;
  top: -200rpx;
  right: -160rpx;
  border-color: rgba(0, 119, 194, 0.12);
  background: radial-gradient(circle, rgba(0, 119, 194, 0.06) 0%, transparent 70%);
}

.deco-ring-2 {
  width: 360rpx;
  height: 360rpx;
  bottom: -80rpx;
  left: -100rpx;
  border-color: rgba(0, 119, 194, 0.08);
  background: radial-gradient(circle, rgba(0, 119, 194, 0.04) 0%, transparent 70%);
}

.deco-ring-3 {
  width: 200rpx;
  height: 200rpx;
  top: 40%;
  right: -60rpx;
  border-color: rgba(89, 165, 245, 0.06);
  background: radial-gradient(circle, rgba(89, 165, 245, 0.03) 0%, transparent 70%);
}

/* ── 品牌区域 ── */
.login-header {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 160rpx;
  margin-bottom: 80rpx;
}

.brand-icon {
  width: 96rpx;
  height: 96rpx;
  background: linear-gradient(135deg, #0077C2, #59a5f5);
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
  box-shadow: 0 12rpx 40rpx rgba(0, 119, 194, 0.25);
}

.brand-icon-text {
  font-size: 44rpx;
  font-weight: 700;
  color: #ffffff;
}

.brand-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #333333;
  letter-spacing: 2rpx;
  margin-bottom: 24rpx;
}

.brand-bar {
  width: 80rpx;
  height: 4rpx;
  background: linear-gradient(90deg, #0077C2, #59a5f5);
  border-radius: 2rpx;
}

/* ── 表单卡片（毛玻璃） ── */
.login-card {
  position: relative;
  z-index: 1;
  width: 100%;
  background: rgba(255, 255, 255, 0.65);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  border-radius: 36rpx;
  padding: 52rpx 44rpx;
  box-shadow:
    0 4rpx 24rpx rgba(0, 0, 0, 0.03),
    0 1rpx 4rpx rgba(0, 0, 0, 0.02);
}

.form-group {
  margin-bottom: 44rpx;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: rgba(0, 0, 0, 0.4);
  margin-bottom: 16rpx;
  letter-spacing: 1rpx;
}

.form-input {
  width: 100%;
  font-size: 32rpx;
  color: #333333;
  height: 52rpx;
  padding: 0;
  background: transparent;
}

.form-input::placeholder {
  color: rgba(0, 0, 0, 0.15);
}

.input-wrapper {
  position: relative;
  border-bottom: 2rpx solid rgba(0, 0, 0, 0.06);
  padding-bottom: 20rpx;
}

.form-group:first-child .form-input {
  border-bottom: 2rpx solid rgba(0, 0, 0, 0.06);
  padding-bottom: 20rpx;
}

.toggle-pwd {
  position: absolute;
  right: 0;
  bottom: 20rpx;
  padding: 4rpx 8rpx;
}

.toggle-text {
  font-size: 26rpx;
  color: rgba(0, 119, 194, 0.55);
}

/* ── 登录按钮 ── */
.login-btn {
  margin-top: 16rpx;
  width: 100%;
  height: 100rpx;
  background: linear-gradient(135deg, #0077C2, #59a5f5);
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 600;
  border-radius: 24rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  letter-spacing: 4rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 119, 194, 0.3);
}

.login-btn::after {
  border: none;
}

.login-btn[disabled] {
  opacity: 0.5;
}

/* ── 提示 ── */
.login-hint {
  margin-top: 40rpx;
  text-align: center;
}

.hint-text {
  font-size: 24rpx;
  color: rgba(0, 0, 0, 0.25);
}
