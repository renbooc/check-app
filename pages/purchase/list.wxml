<view class="page">
  <view class="search-bar">
    <view class="search-input-wrap">
      <icon-cmp type="search" size="18" color="#999999"></icon-cmp>
      <input class="search-input" placeholder="搜索订单号" value="{{keyword}}" bindinput="onSearchInput" bindconfirm="onSearch" />
    </view>
  </view>

  <view class="loading-container" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
  </view>

  <view class="empty-container" wx:elif="{{list.length === 0}}">
    <text class="empty-text">暂无采购订单</text>
  </view>

  <view class="order-list" wx:else>
    <view class="order-card" wx:for="{{list}}" wx:key="id" bindtap="onDetail" data-id="{{item.id}}">
      <view class="order-header">
        <text class="order-no">{{item.orderNo}}</text>
        <text class="order-status status-{{item.status}}">{{item.status === 'pending' ? '待审核' : item.status === 'approved' ? '已审核' : item.status === 'received' ? '已入库' : item.status}}</text>
      </view>
      <view class="order-body">
        <text class="order-party">{{item.supplier ? item.supplier.name : '-'}}</text>
        <text class="order-amount">¥{{item.totalAmount || '0.00'}}</text>
      </view>
      <view class="order-footer">
        <text class="order-date">{{item.createdAt}}</text>
        <text class="order-operator">{{item.operatorName}}</text>
      </view>
    </view>
  </view>

  <view class="fab" bindtap="onCreate">
    <icon-cmp type="plus" size="24" color="#FFFFFF"></icon-cmp>
  </view>
</view>
