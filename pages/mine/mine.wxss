/* ============================================================
   我的页面 — 个人中心
   背景 #f5f5f5 / Hero 渐变 / 卡片 #FFFFFF / 主色 #0077C2
   ============================================================ */

.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.placeholder { color: #ccc; font-size: 26rpx; }

/* ============================================================
   Loading（与首页统一）
   ============================================================ */
.loading-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.loading-dot {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #f0f0f0;
  border-top-color: #0077C2;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* ============================================================
   用户信息 Hero
   ============================================================ */
.hero {
  background: linear-gradient(135deg, #0077C2 0%, #4a9fe5 100%);
  margin: 20rpx 20rpx 0;
  padding: 48rpx 32rpx 36rpx;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 119, 194, 0.2);
  position: relative;
  overflow: hidden;
}

.hero-bg {
  position: absolute;
  top: -120rpx;
  right: -80rpx;
  width: 400rpx;
  height: 400rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.05);
  pointer-events: none;
}

.hero-content {
  display: flex;
  align-items: center;
  position: relative;
  z-index: 1;
}

.hero-avatar-wrap {
  position: relative;
  flex-shrink: 0;
  margin-right: 28rpx;
}

.hero-avatar-inner {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  overflow: hidden;
  position: relative;
  z-index: 1;
}

.hero-avatar {
  width: 100%;
  height: 100%;
  display: block;
}

.avatar-gradient {
  background: linear-gradient(135deg, #0077C2 0%, #4a9fe5 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-gradient .hero-avatar {
  width: 80rpx;
  height: 80rpx;
  filter: brightness(0) invert(1);
}

.hero-avatar-ring {
  position: absolute;
  top: -6rpx;
  left: -6rpx;
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
}

.hero-info {
  flex: 1;
  min-width: 0;
}

.hero-name {
  display: block;
  font-size: 40rpx;
  font-weight: 800;
  color: #FFFFFF;
  margin-bottom: 14rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hero-role {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 20rpx;
  background: rgba(255, 255, 255, 0.12);
  border-radius: 100rpx;
}

.hero-role-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #5AE880;
  flex-shrink: 0;
}

.hero-role-text {
  font-size: 22rpx;
  font-weight: 500;
  color: rgba(255, 255, 255, 0.85);
}

.hero-edit {
  position: absolute;
  top: -8rpx;
  right: 0;
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.22);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid rgba(255, 255, 255, 0.15);
}

.hero-edit:active {
  background: rgba(255, 255, 255, 0.35);
}

.hero-foot {
  position: relative;
  z-index: 1;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.12);
}

.hero-foot-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.45);
}

/* ============================================================
   统计卡（与首页 KPI 统一）
   ============================================================ */
.stats-card {
  background: #FFFFFF;
  margin: 20rpx 20rpx 0;
  padding: 28rpx 0 24rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.stats-row {
  display: flex;
  align-items: stretch;
}

.stats-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  border-right: 1rpx solid #f5f5f5;
  padding: 4rpx 0;
}

.stats-cell:last-child {
  border-right: none;
}

.stats-cell:active {
  background: #fafafa;
}

.stats-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #333333;
  line-height: 1;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', sans-serif;
}

.stats-num-warn {
  color: #FF7D00;
}

.stats-label-row {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.stats-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.stats-dot-blue   { background: #0077C2; }
.stats-dot-green  { background: #00B42A; }
.stats-dot-amber  { background: #FF7D00; }

.stats-label {
  font-size: 24rpx;
  color: #5c5c5c;
  font-weight: 500;
}

/* ============================================================
   菜单分组
   ============================================================ */
.menu-section {
  padding: 0 20rpx;
}

.menu-group {
  margin-top: 28rpx;
}

.menu-group-title {
  display: block;
  font-size: 22rpx;
  color: #999;
  font-weight: 500;
  padding: 0 12rpx 12rpx;
  letter-spacing: 1rpx;
}

.menu-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  overflow: hidden;
}

/* ---------- 菜单项 ---------- */
.menu-item {
  display: flex;
  align-items: center;
  padding: 24rpx 24rpx;
  position: relative;
}

.menu-item:active {
  background: #f8f8f8;
}

.menu-item + .menu-item {
  border-top: 1rpx solid #f5f5f5;
}

/* ---------- 图标 ---------- */
.menu-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-bg-blue   { background: #EEF4FF; }
.icon-bg-green  { background: #ECFDF5; }
.icon-bg-amber  { background: #FFF8E6; }
.icon-bg-rose   { background: #FFF1F2; }
.icon-bg-purple { background: #F3EEFF; }
.icon-bg-cyan   { background: #E6FFFB; }
.icon-bg-gray   { background: #F2F3F5; }

.menu-icon-img {
  width: 32rpx;
  height: 32rpx;
  display: block;
}

.menu-label {
  flex: 1;
  font-size: 28rpx;
  font-weight: 500;
  color: #333333;
}

/* ============================================================
   退出登录
   ============================================================ */
.logout-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  height: 88rpx;
  margin: 48rpx 20rpx 0;
  background: #FFFFFF;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.logout-btn:active {
  background: #FFF5F5;
}

.logout-icon {
  width: 28rpx;
  height: 28rpx;
  display: block;
  opacity: 0.55;
}

.logout-text {
  font-size: 28rpx;
  color: #E53E3E;
  font-weight: 500;
}

/* ============================================================
   版本号
   ============================================================ */
.version-bar {
  text-align: center;
  padding: 28rpx 0 20rpx;
}

.version-text {
  font-size: 22rpx;
  color: #ccc;
}
