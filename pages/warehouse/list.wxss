/* ============================================================
   仓库管理列表 — 与供应商管理统一设计语言
   ============================================================ */

/* ---------- 页面基础 ---------- */
.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

/* ---------- 搜索栏 ---------- */
.search-bar {
  padding: 20rpx 20rpx 0;
  position: sticky;
  top: 0;
  z-index: 10;
  background: #f5f5f5;
}

.search-box {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 12rpx;
  padding: 0 20rpx;
  height: 76rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.search-icon {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  border: 4rpx solid #cccccc;
  margin-right: 14rpx;
  flex-shrink: 0;
  position: relative;
}

.search-icon::after {
  content: '';
  position: absolute;
  width: 4rpx;
  height: 10rpx;
  background: #cccccc;
  bottom: -8rpx;
  right: -6rpx;
  transform: rotate(45deg);
  border-radius: 2rpx;
}

.search-input {
  flex: 1;
  height: 100%;
  font-size: 28rpx;
  color: #333333;
}

.search-clear {
  width: 36rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.clear-icon {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: #cccccc;
  position: relative;
}

.clear-icon::before,
.clear-icon::after {
  content: '';
  position: absolute;
  width: 12rpx;
  height: 2rpx;
  background: #FFFFFF;
  top: 50%;
  left: 50%;
  border-radius: 1rpx;
}

.clear-icon::before { transform: translate(-50%, -50%) rotate(45deg); }
.clear-icon::after  { transform: translate(-50%, -50%) rotate(-45deg); }

/* ---------- 内容区域 ---------- */
.content-area {
  padding: 20rpx 20rpx 0;
}

/* ---------- 加载骨架 ---------- */
.skeleton-wrap {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.skeleton-card {
  background: #FFFFFF;
  border-radius: 12rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.skeleton-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.skeleton-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #f0f0f0;
  flex-shrink: 0;
}

.skeleton-lines {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.skeleton-line {
  height: 24rpx;
  background: #f0f0f0;
  border-radius: 4rpx;
}

.skeleton-name { width: 40%; }
.skeleton-phone { width: 60%; }

/* ---------- 空状态 ---------- */
.empty-wrap {
  padding: 100rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.empty-icon-wrap {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 8rpx;
}

.empty-icon-search {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  border: 6rpx solid #cccccc;
  position: relative;
}

.empty-icon-search::after {
  content: '';
  position: absolute;
  width: 6rpx;
  height: 20rpx;
  background: #cccccc;
  bottom: -14rpx;
  right: -10rpx;
  transform: rotate(45deg);
  border-radius: 3rpx;
}

.empty-icon-box {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #cccccc;
  border-radius: 8rpx;
}

.empty-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}

.empty-desc {
  font-size: 24rpx;
  color: #999999;
}

/* ---------- 列表卡片 ---------- */
.list-wrap {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.list-card {
  display: flex;
  align-items: flex-start;
  background: #FFFFFF;
  border-radius: 12rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.list-card:active {
  background: #f5f5f5;
}

.card-left {
  flex-shrink: 0;
  margin-right: 20rpx;
}

.card-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.avatar-warehouse {
  background: linear-gradient(135deg, #0077C2, #59a5f5);
}

.card-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.card-name-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.card-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-info-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.card-info-text {
  font-size: 24rpx;
  color: #5c5c5c;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 地址图标 */
.info-icon-addr {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50% 50% 50% 0;
  background: #0077C2;
  flex-shrink: 0;
  transform: rotate(-45deg);
  position: relative;
}

.info-icon-addr::after {
  content: '';
  position: absolute;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #FFFFFF;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}

/* ---------- 状态标签 ---------- */
.status-tag {
  font-size: 20rpx;
  font-weight: 500;
  padding: 4rpx 12rpx;
  border-radius: 100rpx;
  flex-shrink: 0;
}

.tag-active {
  background: #ECFDF5;
  color: #00B42A;
}

.tag-inactive {
  background: #f5f5f5;
  color: #999999;
}

/* ---------- 加载更多 ---------- */
.load-more {
  text-align: center;
  padding: 24rpx 0;
}

.load-more-text {
  font-size: 24rpx;
  color: #cccccc;
}

/* ---------- 底部操作栏 ---------- */
.bottom-action {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  padding: 0 24rpx calc(24rpx + env(safe-area-inset-bottom));
  background: linear-gradient(to top, #f5f7fa 60%, transparent);
  pointer-events: none;
}

.action-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 16rpx 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
  pointer-events: auto;
}

.action-count {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
  flex-shrink: 0;
}

.count-num {
  font-size: 32rpx;
  font-weight: 700;
  color: #0077C2;
}

.count-label {
  font-size: 24rpx;
  color: #5c5c5c;
}

.action-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  height: 80rpx;
  padding: 0 36rpx;
  border-radius: 16rpx;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
}

.action-btn:active {
  opacity: 0.85;
}

.action-btn-warehouse {
  background: #0077C2;
}

.btn-plus {
  width: 28rpx;
  height: 28rpx;
  position: relative;
}

.btn-plus::before,
.btn-plus::after {
  content: '';
  position: absolute;
  background: #FFFFFF;
  border-radius: 2rpx;
}

.btn-plus::before {
  width: 100%;
  height: 3rpx;
  top: 50%;
  left: 0;
  transform: translateY(-50%);
}

.btn-plus::after {
  width: 3rpx;
  height: 100%;
  left: 50%;
  top: 0;
  transform: translateX(-50%);
}

/* ============================================================
   弹窗表单 — 与供应商管理统一风格
   ============================================================ */

/* 遮罩 */
.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 200;
}

/* 面板 */
.modal-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 201;
  background: #FFFFFF;
  border-radius: 24rpx 24rpx 0 0;
  padding: 0 32rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  transform: translateY(100%);
  transition: transform 0.25s ease;
}

.modal-panel.show {
  transform: translateY(0);
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
  border-bottom: 2rpx solid #f5f5f5;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #333333;
}

.modal-close {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
}

.close-icon {
  width: 20rpx;
  height: 20rpx;
  position: relative;
}

.close-icon::before,
.close-icon::after {
  content: '';
  position: absolute;
  width: 100%;
  height: 2rpx;
  background: #999999;
  top: 50%;
  left: 0;
  border-radius: 1rpx;
}

.close-icon::before { transform: translateY(-50%) rotate(45deg); }
.close-icon::after  { transform: translateY(-50%) rotate(-45deg); }

/* 表单行 */
.modal-body {
  padding: 24rpx 0;
}

.form-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f5f5f5;
}

.form-row:last-child {
  border-bottom: none;
}

.form-label {
  width: 120rpx;
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
  flex-shrink: 0;
}

.form-input {
  flex: 1;
  height: 60rpx;
  font-size: 28rpx;
  color: #333333;
  text-align: right;
}

.form-picker {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  height: 60rpx;
  font-size: 28rpx;
  color: #0077C2;
  gap: 6rpx;
}

.picker-arrow {
  width: 12rpx;
  height: 12rpx;
  border-right: 3rpx solid #cccccc;
  border-bottom: 3rpx solid #cccccc;
  transform: rotate(45deg);
  margin-top: -4rpx;
}

/* 底部按钮 */
.modal-footer {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding-top: 16rpx;
}

.footer-right {
  flex: 1;
  display: flex;
  gap: 16rpx;
}

.btn-delete {
  flex-shrink: 0;
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 28rpx;
  background: #fff1f0;
  color: #ff4d4f;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
  text-align: center;
}

.btn-cancel {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  background: #f5f5f5;
  color: #5c5c5c;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
  text-align: center;
}

.btn-confirm {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #FFFFFF;
  border: none;
  text-align: center;
}

.btn-confirm-warehouse {
  background: #0077C2;
}

.btn-confirm-warehouse:active {
  opacity: 0.9;
}

.btn-delete:active {
  background: #ffe8e7;
}
