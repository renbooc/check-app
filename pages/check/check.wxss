/* ============================================================
   库存盘点页 — 企业级盘点工作台
   背景 #f5f5f5 / 卡片 #FFFFFF / 主色 #0077C2
   ============================================================ */

.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

/* ============================================================
   顶部标签（两 Tab + 底线指示器）
   ============================================================ */
.tabs {
  background: #FFFFFF;
  display: flex;
  padding: 0 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
  position: sticky;
  top: 0;
  z-index: 10;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0 20rpx;
  position: relative;
  font-size: 28rpx;
  font-weight: 500;
  color: #5c5c5c;
}

.tab-item.active {
  color: #0077C2;
  font-weight: 600;
}

.tab-line {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: #0077C2;
}

/* ============================================================
   搜索栏（白卡片）
   ============================================================ */
.search-card {
  background: #FFFFFF;
  margin: 20rpx 24rpx 0;
  padding: 16rpx 16rpx 16rpx 24rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.search-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  min-width: 0;
}

.search-icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
  margin-right: 16rpx;
  opacity: 0.4;
}

.search-input {
  flex: 1;
  font-size: 26rpx;
  color: #333333;
  min-width: 0;
}

.scan-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: rgba(0, 119, 194, 0.06);
  border-radius: 12rpx;
}

.scan-btn:active {
  background: rgba(0, 119, 194, 0.12);
}

.scan-icon {
  width: 36rpx;
  height: 36rpx;
}

/* ============================================================
   Loading
   ============================================================ */
.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  gap: 20rpx;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #f5f5f5;
  border-top-color: #0077C2;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 24rpx;
  color: #5c5c5c;
}

/* ============================================================
   空状态 — 开始盘点
   ============================================================ */
.start-wrap {
  padding: 60rpx 40rpx;
}

.start-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 64rpx 40rpx 48rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.start-img {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 32rpx;
  opacity: 0.85;
}

.start-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #333333;
  margin-bottom: 16rpx;
}

.start-desc {
  display: block;
  font-size: 24rpx;
  color: #5c5c5c;
  line-height: 1.6;
  margin-bottom: 40rpx;
}

.start-btn {
  width: 100%;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #0077C2;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 16rpx;
  border: none;
  margin-bottom: 24rpx;
}

.start-btn:active {
  background: #005a8e;
}

.start-hint {
  display: block;
  font-size: 22rpx;
  color: #cccccc;
}

/* ============================================================
   商品 Hero 卡（盘点核心信息）
   ============================================================ */
.product-card {
  background: #FFFFFF;
  margin: 20rpx 24rpx 0;
  border-radius: 16rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.product-top {
  display: flex;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.product-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  background: #f5f5f5;
  flex-shrink: 0;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.product-img image {
  width: 88rpx;
  height: 88rpx;
}

.product-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 8rpx;
}

.product-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #333333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-spec {
  font-size: 24rpx;
  color: #5c5c5c;
}

.product-code {
  font-size: 22rpx;
  color: #cccccc;
}

/* 库存对比 */
.stock-compare {
  display: flex;
  background: #f8f9fa;
  border-radius: 12rpx;
  padding: 24rpx 0;
}

.stock-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.stock-label {
  font-size: 22rpx;
  color: #5c5c5c;
}

.stock-val {
  font-size: 44rpx;
  font-weight: 700;
  color: #333333;
  line-height: 1;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', sans-serif;
}

.stock-val.highlight {
  color: #0077C2;
}

.stock-sep {
  width: 1rpx;
  background: #e8e8e8;
  margin: 8rpx 0;
}

/* ============================================================
   调整数量面板
   ============================================================ */
.count-card {
  background: #FFFFFF;
  margin: 20rpx 24rpx 0;
  border-radius: 16rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.count-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.count-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}

.count-diff {
  font-size: 26rpx;
  font-weight: 700;
  padding: 6rpx 20rpx;
  border-radius: 100rpx;
}

.count-diff.positive {
  color: #00B42A;
  background: rgba(0, 180, 42, 0.08);
}

.count-diff.negative {
  color: #e74c3c;
  background: rgba(231, 76, 60, 0.08);
}

.count-diff.zero {
  color: #5c5c5c;
  background: #f5f5f5;
}

.count-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.count-btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  flex-shrink: 0;
  font-size: 36rpx;
  font-weight: 600;
}

.count-btn.minus {
  background: #f5f5f5;
  color: #5c5c5c;
}

.count-btn.plus {
  background: #0077C2;
  color: #FFFFFF;
}

.count-btn:active {
  opacity: 0.7;
}

.count-input {
  flex: 1;
  height: 72rpx;
  text-align: center;
  font-size: 36rpx;
  font-weight: 700;
  color: #333333;
  background: #f8f9fa;
  border-radius: 12rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', sans-serif;
}

.count-unit {
  font-size: 24rpx;
  color: #5c5c5c;
  flex-shrink: 0;
  margin-left: 4rpx;
}

/* ============================================================
   库位/批次折叠卡
   ============================================================ */
.fold-card {
  background: #FFFFFF;
  margin: 20rpx 24rpx 0;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  overflow: hidden;
}

.fold-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx;
}

.fold-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}

.fold-arrow {
  font-size: 32rpx;
  color: #cccccc;
  transition: transform 0.25s;
  transform: rotate(0deg);
}

.fold-arrow.open {
  transform: rotate(90deg);
}

.fold-body {
  padding: 0 28rpx 28rpx;
}

.fold-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-top: 1rpx solid #f5f5f5;
}

.fold-row.clickable {
  padding-right: 0;
}

.fold-key {
  font-size: 26rpx;
  color: #5c5c5c;
  width: 120rpx;
  flex-shrink: 0;
}

.fold-val {
  flex: 1;
  font-size: 26rpx;
  color: #333333;
  font-weight: 500;
}

.fold-go {
  font-size: 32rpx;
  color: #cccccc;
  margin-left: 8rpx;
}

/* ============================================================
   备注
   ============================================================ */
.remark-card {
  background: #FFFFFF;
  margin: 20rpx 24rpx 0;
  border-radius: 16rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.remark-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.remark-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}

.remark-count {
  font-size: 22rpx;
  color: #cccccc;
}

.remark-input {
  width: 100%;
  height: 120rpx;
  font-size: 26rpx;
  color: #333333;
  background: #f8f9fa;
  border-radius: 12rpx;
  padding: 20rpx;
  box-sizing: border-box;
}

/* ============================================================
   操作按钮栏
   ============================================================ */
.action-bar {
  padding: 32rpx 24rpx 0;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.btn-save {
  width: 100%;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #0077C2;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 16rpx;
  border: none;
}

.btn-save:active {
  background: #005a8e;
}

.btn-next {
  width: 100%;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FFFFFF;
  color: #0077C2;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 16rpx;
  border: 2rpx solid rgba(0, 119, 194, 0.2);
}

.btn-next:active {
  background: rgba(0, 119, 194, 0.04);
}

/* ============================================================
   库位网格（按库位盘点 Tab）
   ============================================================ */
.loc-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 20rpx 24rpx;
  gap: 16rpx;
}

.loc-item {
  width: calc(33.333% - 12rpx);
  background: #FFFFFF;
  border-radius: 12rpx;
  padding: 24rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
  border: 2rpx solid transparent;
}

.loc-item.selected {
  border-color: #0077C2;
  background: rgba(0, 119, 194, 0.04);
}

.loc-item:active {
  background: #f8f9fa;
}

.loc-icon {
  width: 32rpx;
  height: 32rpx;
  opacity: 0.6;
}

.loc-code {
  font-size: 24rpx;
  font-weight: 600;
  color: #333333;
}

/* ============================================================
   库位商品列表
   ============================================================ */
.section-head {
  padding: 24rpx 32rpx 12rpx;
}

.section-label {
  font-size: 24rpx;
  color: #5c5c5c;
  font-weight: 500;
}

.lp-list {
  padding: 0 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.lp-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.lp-card:active {
  background: #fafafa;
}

.lp-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.lp-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.lp-spec {
  font-size: 22rpx;
  color: #5c5c5c;
}

.lp-stock {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.lp-count {
  font-size: 40rpx;
  font-weight: 700;
  color: #0077C2;
  line-height: 1;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', sans-serif;
}

.lp-unit {
  font-size: 22rpx;
  color: #5c5c5c;
}

/* ============================================================
   空状态
   ============================================================ */
.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 48rpx;
}

.empty-img {
  width: 100rpx;
  height: 100rpx;
  margin-bottom: 24rpx;
  opacity: 0.25;
}

.empty-text {
  font-size: 26rpx;
  color: #5c5c5c;
}

/* ============================================================
   撤销提示条（底部 Toast）
   ============================================================ */
.undo-bar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: -100rpx;
  background: #333333;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  z-index: 200;
  transition: bottom 0.3s ease-out;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.2);
}

.undo-bar.visible {
  bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.undo-text {
  font-size: 26rpx;
  color: #FFFFFF;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.undo-btn {
  padding: 8rpx 24rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.15);
  flex-shrink: 0;
  margin-left: 16rpx;
}

.undo-btn text {
  font-size: 24rpx;
  color: #59a5f5;
  font-weight: 600;
}

.undo-btn:active {
  background: rgba(255, 255, 255, 0.25);
}
