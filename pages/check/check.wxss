/* ============================================================
   库存盘点页 — 企业级盘点工作台
   背景 #f5f5f5 / 卡片 #FFFFFF / 主色 #0077C2
   设计原则：数量调整为视觉主役，其余为支撑信息
   ============================================================ */

.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

/* ============================================================
   顶部标签
   ============================================================ */
.tabs {
  background: #FFFFFF;
  display: flex;
  padding: 0 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
  position: sticky;
  top: 0;
  z-index: 10;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0 20rpx;
  position: relative;
  font-size: 28rpx;
  font-weight: 500;
  color: #5c5c5c;
}

.tab-item.active {
  color: #0077C2;
  font-weight: 600;
}

.tab-line {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: #0077C2;
}

/* ============================================================
   搜索栏
   ============================================================ */
.search-card {
  background: #FFFFFF;
  margin: 20rpx 24rpx 0;
  padding: 16rpx 16rpx 16rpx 24rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.search-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  min-width: 0;
}

.search-icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
  margin-right: 16rpx;
  opacity: 0.4;
}

.search-input {
  flex: 1;
  font-size: 26rpx;
  color: #333333;
  min-width: 0;
}

.scan-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: rgba(0, 119, 194, 0.06);
  border-radius: 12rpx;
}

.scan-btn:active {
  background: rgba(0, 119, 194, 0.12);
}

.scan-icon {
  width: 36rpx;
  height: 36rpx;
}

/* ============================================================
   Loading
   ============================================================ */
.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  gap: 20rpx;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #f5f5f5;
  border-top-color: #0077C2;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 24rpx;
  color: #5c5c5c;
}

/* ============================================================
   空状态 — 开始盘点
   ============================================================ */
.start-wrap {
  padding: 60rpx 40rpx;
}

.start-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 64rpx 40rpx 48rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.start-img {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 32rpx;
  opacity: 0.85;
}

.start-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #333333;
  margin-bottom: 16rpx;
}

.start-desc {
  display: block;
  font-size: 24rpx;
  color: #5c5c5c;
  line-height: 1.6;
  margin-bottom: 40rpx;
}

.start-btn {
  width: 100%;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #0077C2;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 16rpx;
  border: none;
  margin-bottom: 24rpx;
}

.start-btn:active {
  background: #005a8e;
}

.start-hint {
  display: block;
  font-size: 22rpx;
  color: #cccccc;
}

/* ============================================================
   搜索栏清除按钮
   ============================================================ */
.search-clear {
  width: 36rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-left: 8rpx;
  background: #e0e0e0;
  border-radius: 50%;
}

.search-clear text {
  font-size: 28rpx;
  color: #FFFFFF;
  line-height: 1;
}

.search-clear:active {
  opacity: 0.6;
}

/* ============================================================
   搜索下拉候选列表（紧贴搜索栏下方）
   ============================================================ */
.search-dropdown {
  margin: 4rpx 24rpx 0;
  background: #FFFFFF;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.08);
  overflow: hidden;
}

.search-dropdown-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 32rpx 0;
}

.loading-spinner.small {
  width: 32rpx;
  height: 32rpx;
  border-width: 3rpx;
}

.search-dropdown-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 28rpx 12rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.search-dropdown-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #333333;
}

.search-dropdown-hint {
  font-size: 22rpx;
  color: #cccccc;
}

.search-dropdown-scroll {
  max-height: 720rpx;
}

.dropdown-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 28rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.dropdown-item:last-child {
  border-bottom: none;
}

.dropdown-item:active {
  background: #fafafa;
}

.dropdown-item-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 10rpx;
  background: linear-gradient(135deg, #0077C2, #005a8e);
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.dropdown-item-icon text {
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
  line-height: 1;
}

.dropdown-item-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.dropdown-item-name-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.dropdown-item-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex-shrink: 1;
  min-width: 0;
}

.dropdown-item-spec-tag {
  font-size: 20rpx;
  color: #0077C2;
  background: rgba(0, 119, 194, 0.08);
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  flex-shrink: 0;
  max-width: 280rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dropdown-item-sub {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-wrap: wrap;
}

.dropdown-item-manufacturer {
  font-size: 20rpx;
  color: #5c5c5c;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 300rpx;
}

.dropdown-item-approval {
  font-size: 20rpx;
  color: #cccccc;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dropdown-item-stock {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
  flex-shrink: 0;
  margin-left: 8rpx;
}

.dropdown-item-count {
  font-size: 32rpx;
  font-weight: 700;
  color: #0077C2;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', sans-serif;
}

.dropdown-item-unit {
  font-size: 20rpx;
  color: #5c5c5c;
}

.search-dropdown-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx 0;
}

.search-dropdown-empty text {
  font-size: 24rpx;
  color: #cccccc;
}

/* ============================================================
   商品信息卡（紧凑，支撑信息）
   ============================================================ */
.product-card {
  background: #FFFFFF;
  margin: 20rpx 24rpx 0;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  display: flex;
  gap: 20rpx;
}

.product-img {
  width: 100rpx;
  height: 100rpx;
  border-radius: 12rpx;
  background: linear-gradient(135deg, #0077C2, #005a8e);
  flex-shrink: 0;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.product-img image {
  width: 80rpx;
  height: 80rpx;
}

.product-img-initial {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.product-img-initial text {
  font-size: 48rpx;
  font-weight: 700;
  color: #FFFFFF;
  line-height: 1;
}

.product-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 6rpx;
}

.product-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #333333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-manufacturer {
  font-size: 22rpx;
  color: #5c5c5c;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.product-spec {
  font-size: 24rpx;
  color: #5c5c5c;
}

.product-unit-tag {
  font-size: 20rpx;
  color: #0077C2;
  background: rgba(0, 119, 194, 0.08);
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  flex-shrink: 0;
}

.product-code {
  font-size: 22rpx;
  color: #cccccc;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ============================================================
   数量调整卡（主役，最大视觉权重）
   ============================================================ */
.count-card {
  background: #FFFFFF;
  margin: 16rpx 24rpx 0;
  border-radius: 16rpx;
  padding: 0;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  overflow: hidden;
}

/* 差异横幅：最醒目的视觉锚点 */
.count-diff-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 28rpx;
}

.count-diff-banner.zero {
  background: #f5f5f5;
}

.count-diff-banner.positive {
  background: rgba(0, 180, 42, 0.08);
}

.count-diff-banner.negative {
  background: rgba(231, 76, 60, 0.08);
}

.count-diff-label {
  font-size: 28rpx;
  font-weight: 700;
}

.count-diff-banner.zero .count-diff-label {
  color: #5c5c5c;
}

.count-diff-banner.positive .count-diff-label {
  color: #00B42A;
}

.count-diff-banner.negative .count-diff-label {
  color: #e74c3c;
}

.count-diff-val {
  font-size: 32rpx;
  font-weight: 700;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', sans-serif;
}

.count-diff-banner.positive .count-diff-val {
  color: #00B42A;
}

.count-diff-banner.negative .count-diff-val {
  color: #e74c3c;
}

/* 库存对比 */
.count-compare {
  display: flex;
  align-items: center;
  padding: 32rpx 28rpx 20rpx;
  gap: 20rpx;
}

.count-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.count-cell-label {
  font-size: 22rpx;
  color: #5c5c5c;
}

.count-cell-val {
  font-size: 56rpx;
  font-weight: 700;
  color: #333333;
  line-height: 1;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', sans-serif;
}

.count-cell.primary .count-cell-val {
  color: #0077C2;
}

.count-arrow {
  font-size: 36rpx;
  color: #cccccc;
  flex-shrink: 0;
  margin-top: 20rpx;
}

/* 数量调整器 */
.count-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 0 28rpx 32rpx;
}

.count-btn {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  flex-shrink: 0;
  font-size: 40rpx;
  font-weight: 600;
}

.count-btn.minus {
  background: #f5f5f5;
  color: #5c5c5c;
}

.count-btn.plus {
  background: #0077C2;
  color: #FFFFFF;
}

.count-btn:active {
  opacity: 0.7;
}

.count-input {
  flex: 1;
  height: 80rpx;
  text-align: center;
  font-size: 40rpx;
  font-weight: 700;
  color: #333333;
  background: #f8f9fa;
  border-radius: 16rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', sans-serif;
}

.count-unit {
  font-size: 24rpx;
  color: #5c5c5c;
  flex-shrink: 0;
}

/* ============================================================
   详情折叠卡（库位 + 批次 + 备注 合并）
   ============================================================ */
.fold-card {
  background: #FFFFFF;
  margin: 16rpx 24rpx 0;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  overflow: hidden;
}

.fold-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
}

.fold-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}

.fold-arrow {
  font-size: 32rpx;
  color: #cccccc;
  transition: transform 0.25s;
  transform: rotate(0deg);
}

.fold-arrow.open {
  transform: rotate(90deg);
}

.fold-body {
  padding: 0 28rpx 24rpx;
}

.fold-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-top: 1rpx solid #f5f5f5;
}

.fold-row.clickable {
  padding-right: 0;
}

.fold-row.fold-remark {
  align-items: flex-start;
}

.fold-key {
  font-size: 26rpx;
  color: #5c5c5c;
  width: 120rpx;
  flex-shrink: 0;
}

.fold-val {
  flex: 1;
  font-size: 26rpx;
  color: #333333;
  font-weight: 500;
}

.fold-go {
  font-size: 32rpx;
  color: #cccccc;
  margin-left: 8rpx;
}

.fold-remark-input {
  flex: 1;
  min-height: 60rpx;
  font-size: 26rpx;
  color: #333333;
  background: #f8f9fa;
  border-radius: 10rpx;
  padding: 12rpx 16rpx;
  box-sizing: border-box;
}

/* ============================================================
   操作按钮（主次分明）
   ============================================================ */
.action-bar {
  padding: 32rpx 24rpx 0;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.btn-save {
  width: 100%;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #0077C2;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 700;
  border-radius: 16rpx;
  border: none;
  box-shadow: 0 4rpx 16rpx rgba(0, 119, 194, 0.25);
}

.btn-save:active {
  background: #005a8e;
}

.btn-next {
  width: 100%;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  color: #0077C2;
  font-size: 26rpx;
  font-weight: 500;
  border-radius: 16rpx;
}

.btn-next:active {
  background: rgba(0, 119, 194, 0.04);
}

/* ============================================================
   库位网格（按库位盘点 Tab）
   ============================================================ */
.loc-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 20rpx 24rpx;
  gap: 16rpx;
}

.loc-item {
  width: calc(33.333% - 12rpx);
  background: #FFFFFF;
  border-radius: 12rpx;
  padding: 24rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
  border: 2rpx solid transparent;
}

.loc-item.selected {
  border-color: #0077C2;
  background: rgba(0, 119, 194, 0.04);
}

.loc-item:active {
  background: #f8f9fa;
}

.loc-icon {
  width: 32rpx;
  height: 32rpx;
  opacity: 0.6;
}

.loc-code {
  font-size: 24rpx;
  font-weight: 600;
  color: #333333;
}

/* ============================================================
   库位商品列表
   ============================================================ */
.section-head {
  padding: 24rpx 32rpx 12rpx;
}

.section-label {
  font-size: 24rpx;
  color: #5c5c5c;
  font-weight: 500;
}

.lp-list {
  padding: 0 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.lp-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.lp-card:active {
  background: #fafafa;
}

.lp-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.lp-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.lp-spec {
  font-size: 22rpx;
  color: #5c5c5c;
}

.lp-stock {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.lp-count {
  font-size: 40rpx;
  font-weight: 700;
  color: #0077C2;
  line-height: 1;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', sans-serif;
}

.lp-unit {
  font-size: 22rpx;
  color: #5c5c5c;
}

/* ============================================================
   空状态
   ============================================================ */
.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 48rpx;
}

.empty-img {
  width: 100rpx;
  height: 100rpx;
  margin-bottom: 24rpx;
  opacity: 0.25;
}

.empty-text {
  font-size: 26rpx;
  color: #5c5c5c;
}

/* ============================================================
   撤销提示条
   ============================================================ */
.undo-bar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: -100rpx;
  background: #333333;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  z-index: 200;
  transition: bottom 0.3s ease-out;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.2);
}

.undo-bar.visible {
  bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.undo-text {
  font-size: 26rpx;
  color: #FFFFFF;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.undo-btn {
  padding: 8rpx 24rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.15);
  flex-shrink: 0;
  margin-left: 16rpx;
}

.undo-btn text {
  font-size: 24rpx;
  color: #59a5f5;
  font-weight: 600;
}

.undo-btn:active {
  background: rgba(255, 255, 255, 0.25);
}

/* ============================================================
   多批次盘点列表
   ============================================================ */
.batch-section {
  padding: 0 24rpx;
  margin-top: 16rpx;
}

.batch-section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 4rpx 16rpx;
}

.batch-section-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #333333;
}

.batch-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  border-left: 6rpx solid transparent;
}

.batch-card.near-expiry {
  border-left-color: #FF7D00;
}

.batch-card.expired {
  border-left-color: #e74c3c;
  background: #FFF5F5;
}

.batch-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.batch-head-left {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
  flex-wrap: wrap;
}

.batch-no {
  font-size: 28rpx;
  font-weight: 700;
  color: #333333;
}

.batch-no-input {
  font-size: 28rpx;
  font-weight: 700;
  color: #333333;
  background: #f8f9fa;
  border-radius: 8rpx;
  padding: 8rpx 16rpx;
  width: 240rpx;
}

.batch-tags {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-wrap: wrap;
}

.batch-tag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  font-weight: 600;
}

.batch-tag.warn {
  color: #FFFFFF;
  background: #e74c3c;
}

.batch-tag.near {
  color: #FFFFFF;
  background: #FF7D00;
}

.batch-tag.new {
  color: #0077C2;
  background: rgba(0, 119, 194, 0.1);
}

.batch-remove {
  font-size: 24rpx;
  color: #e74c3c;
  padding: 4rpx 12rpx;
  flex-shrink: 0;
}

.batch-remove:active {
  opacity: 0.6;
}

.batch-meta {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 20rpx;
  flex-wrap: wrap;
}

.batch-meta-item {
  font-size: 22rpx;
  color: #5c5c5c;
}

.batch-meta-item.new-expiry {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.batch-meta-label {
  font-size: 22rpx;
  color: #5c5c5c;
  flex-shrink: 0;
}

.batch-expiry-input {
  font-size: 22rpx;
  color: #333333;
  background: #f8f9fa;
  border-radius: 6rpx;
  padding: 4rpx 12rpx;
  width: 200rpx;
}

.batch-count-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0 4rpx;
  border-top: 1rpx solid #f5f5f5;
}

.batch-count-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.batch-count-cell.primary {
  flex: 1.4;
}

.batch-count-cell.diff {
  flex: 0.8;
}

.batch-count-label {
  font-size: 20rpx;
  color: #5c5c5c;
}

.batch-count-val {
  font-size: 32rpx;
  font-weight: 700;
  color: #333333;
  line-height: 1;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', sans-serif;
}

.batch-count-cell.primary .batch-count-val {
  color: #0077C2;
}

.batch-count-cell.diff .batch-count-val {
  color: #5c5c5c;
}

.batch-count-cell.diff.positive .batch-count-val {
  color: #00B42A;
}

.batch-count-cell.diff.negative .batch-count-val {
  color: #e74c3c;
}

.batch-input-group {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.batch-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 10rpx;
  flex-shrink: 0;
  font-size: 32rpx;
  font-weight: 600;
}

.batch-btn.minus {
  background: #f5f5f5;
  color: #5c5c5c;
}

.batch-btn.plus {
  background: #0077C2;
  color: #FFFFFF;
}

.batch-btn:active {
  opacity: 0.7;
}

.batch-input {
  width: 100rpx;
  height: 56rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 700;
  color: #333333;
  background: #f8f9fa;
  border-radius: 10rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', sans-serif;
}

.batch-add {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx;
  margin-bottom: 16rpx;
  background: rgba(0, 119, 194, 0.04);
  border-radius: 16rpx;
  border: 2rpx dashed rgba(0, 119, 194, 0.3);
}

.batch-add:active {
  background: rgba(0, 119, 194, 0.08);
}

.batch-add-text {
  font-size: 26rpx;
  color: #0077C2;
  font-weight: 600;
}
