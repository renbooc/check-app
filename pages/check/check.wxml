<view class="page">

  <!-- ====== 顶部标签 ====== -->
  <view class="tabs">
    <view class="tab-item {{activeTab === 'product' ? 'active' : ''}}" bindtap="onSwitchTab" data-tab="product">
      <text>按商品盘点</text>
      <view class="tab-line" wx:if="{{activeTab === 'product'}}"></view>
    </view>
    <view class="tab-item {{activeTab === 'location' ? 'active' : ''}}" bindtap="onSwitchTab" data-tab="location">
      <text>按库位盘点</text>
      <view class="tab-line" wx:if="{{activeTab === 'location'}}"></view>
    </view>
  </view>

  <!-- ====== 搜索栏 ====== -->
  <view class="search-card">
    <view class="search-input-wrap">
      <image class="search-icon" src="/images/icon-search.png" mode="aspectFit"></image>
      <input class="search-input" placeholder="{{activeTab === 'product' ? '搜索药品名称 / 条码' : '搜索库位编号'}}" value="{{searchKeyword}}" bindinput="onSearchInput" bindconfirm="onSearch" />
    </view>
    <view class="scan-btn" bindtap="onScanCode">
      <image class="scan-icon" src="/images/icon-scan.png" mode="aspectFit"></image>
    </view>
  </view>

  <!-- ============================================================
       按商品盘点 Tab
       ============================================================ -->
  <block wx:if="{{activeTab === 'product'}}">

    <!-- 空状态：开始盘点 -->
    <view class="start-wrap" wx:if="{{!product && !searching}}">
      <view class="start-card">
        <image class="start-img" src="/images/icon-quick-check.png" mode="aspectFit"></image>
        <text class="start-title">开始盘点</text>
        <text class="start-desc">扫描药品条码或搜索名称
快速完成库存盘点</text>
        <button class="start-btn" bindtap="onScanCode">扫码盘点</button>
        <text class="start-hint">也可在上方搜索框输入药品名称</text>
      </view>
    </view>

    <!-- 搜索中 -->
    <view class="loading-wrap" wx:if="{{searching}}">
      <view class="loading-spinner"></view>
      <text class="loading-text">搜索中...</text>
    </view>

    <!-- 商品盘点面板 -->
    <block wx:if="{{product && !searching}}">

      <!-- 商品 Hero 卡 -->
      <view class="product-card">
        <view class="product-top">
          <view class="product-img">
            <image src="{{product.image}}" mode="aspectFit"></image>
          </view>
          <view class="product-info">
            <text class="product-name">{{product.name}}</text>
            <text class="product-spec">{{product.spec}}</text>
            <text class="product-code">{{product.approvalNo}}</text>
          </view>
        </view>
        <!-- 库存对比 -->
        <view class="stock-compare">
          <view class="stock-cell">
            <text class="stock-label">系统库存</text>
            <text class="stock-val">{{product.stockCount}}</text>
          </view>
          <view class="stock-sep"></view>
          <view class="stock-cell">
            <text class="stock-label">盘点数量</text>
            <text class="stock-val highlight">{{checkCount}}</text>
          </view>
        </view>
      </view>

      <!-- 调整数量面板 -->
      <view class="count-card">
        <view class="count-head">
          <text class="count-title">调整数量</text>
          <text class="count-diff {{checkCount > product.stockCount ? 'positive' : checkCount < product.stockCount ? 'negative' : 'zero'}}" wx:if="{{checkCount !== product.stockCount}}">
            {{checkCount > product.stockCount ? '+' : ''}}{{checkCount - product.stockCount}}
          </text>
          <text class="count-diff zero" wx:else>一致</text>
        </view>
        <view class="count-row">
          <view class="count-btn minus" bindtap="onCountMinus">
            <text>−</text>
          </view>
          <input class="count-input" type="number" value="{{checkCount}}" bindinput="onCountInput" />
          <view class="count-btn plus" bindtap="onCountPlus">
            <text>+</text>
          </view>
          <text class="count-unit">{{product.unit}}</text>
        </view>
      </view>

      <!-- 库位/批次折叠 -->
      <view class="fold-card">
        <view class="fold-head" bindtap="onToggleInfoFold">
          <text class="fold-title">库位 / 批次信息</text>
          <text class="fold-arrow {{infoFoldOpen ? 'open' : ''}}">›</text>
        </view>
        <view class="fold-body" wx:if="{{infoFoldOpen}}">
          <view class="fold-row clickable" bindtap="onSelectLocation">
            <text class="fold-key">库位</text>
            <text class="fold-val">{{location || '点击选择'}}</text>
            <text class="fold-go">›</text>
          </view>
          <view class="fold-row">
            <text class="fold-key">批号</text>
            <text class="fold-val">{{batchNo || '-'}}</text>
          </view>
          <view class="fold-row">
            <text class="fold-key">有效期</text>
            <text class="fold-val">{{expiryDate || '-'}}</text>
          </view>
        </view>
      </view>

      <!-- 备注 -->
      <view class="remark-card">
        <view class="remark-head">
          <text class="remark-title">备注</text>
          <text class="remark-count">{{remark.length}}/100</text>
        </view>
        <textarea class="remark-input" placeholder="选填" maxlength="100" value="{{remark}}" bindinput="onRemarkInput"></textarea>
      </view>

      <!-- 操作按钮 -->
      <view class="action-bar">
        <button class="btn-save" bindtap="onSave" loading="{{saving}}" disabled="{{saving}}">保存盘点结果</button>
        <button class="btn-next" bindtap="onContinueScan">继续扫描下一件</button>
      </view>

    </block>
  </block>

  <!-- ============================================================
       按库位盘点 Tab
       ============================================================ -->
  <block wx:if="{{activeTab === 'location'}}">

    <view class="loading-wrap" wx:if="{{locationLoading}}">
      <view class="loading-spinner"></view>
      <text class="loading-text">加载库位...</text>
    </view>

    <!-- 库位网格 -->
    <view class="loc-grid" wx:elif="{{locations.length > 0 && !searching}}">
      <view class="loc-item {{selectedLocation === item.code ? 'selected' : ''}}" wx:for="{{locations}}" wx:key="id" bindtap="onLocationTap" data-location="{{item.code}}">
        <image class="loc-icon" src="/images/icon-stock.png" mode="aspectFit"></image>
        <text class="loc-code">{{item.code}}</text>
      </view>
    </view>

    <view class="loading-wrap" wx:if="{{searching}}">
      <view class="loading-spinner"></view>
      <text class="loading-text">搜索中...</text>
    </view>

    <!-- 库位无商品 -->
    <view class="empty-wrap" wx:if="{{!searching && selectedLocation && locationProducts.length === 0}}">
      <image class="empty-img" src="/images/icon-document.png" mode="aspectFit"></image>
      <text class="empty-text">该库位下暂无商品</text>
    </view>

    <!-- 库位商品列表 -->
    <block wx:if="{{locationProducts.length > 0}}">
      <view class="section-head">
        <text class="section-label">库位 {{selectedLocation}} 的商品</text>
      </view>
      <view class="lp-list">
        <view class="lp-card" wx:for="{{locationProducts}}" wx:key="id" bindtap="onLocationProductTap" data-id="{{item.id}}">
          <view class="lp-info">
            <text class="lp-name">{{item.name}}</text>
            <text class="lp-spec">{{item.spec}}</text>
          </view>
          <view class="lp-stock">
            <text class="lp-count">{{item.stockCount}}</text>
            <text class="lp-unit">{{item.unit}}</text>
          </view>
        </view>
      </view>
    </block>

  </block>

  <!-- ====== 撤销提示条 ====== -->
  <view class="undo-bar {{showUndo ? 'visible' : ''}}" wx:if="{{lastSaved}}">
    <text class="undo-text">已保存「{{lastSaved.productName}}」</text>
    <view class="undo-btn" bindtap="onUndo">
      <text>撤销</text>
    </view>
  </view>

</view>
